{% extends 'base.html.twig' %}

{% trans_default_domain 'dashboard' %}

{% block title %}
    {{ 'title'|trans }}
{% endblock %}

{% block body %}
    <p class="page-eyebrow">
        {{ 'eyebrow'|trans }}
    </p>

    <h1>
        {{ 'title'|trans }}
    </h1>

    <p class="page-description">
        {{ 'description'|trans }}
    </p>

    <section class="dashboard-grid">
        {% if nextSession %}
            <article
                class="
                    dashboard-card
                    dashboard-card--featured
                    dashboard-card--session
                "
                style="
                    --campaign-color:
                    {{ nextSession.campaign.color ?? '#c9a85c' }}
                "
            >
                {% if nextSession.campaign.image %}
                    <div class="dashboard-card__media">
                        <img
                            src="{{ asset(
                                'uploads/campaigns/'
                                ~ nextSession.campaign.image
                            ) }}"
                            alt=""
                        >
                    </div>

                    <div class="dashboard-card__overlay"></div>
                {% endif %}

                <div class="dashboard-card__session-content">
                    <div class="dashboard-card__header">
                        <span class="dashboard-card__icon">
                            ◈
                        </span>

                        <span class="dashboard-card__label">
                            {{ 'next_session.label'|trans }}
                        </span>
                    </div>

                    <div class="dashboard-card__content">
                        <h2>
                            {{
                                nextSession.name
                                ?: nextSession.campaign.name
                            }}
                        </h2>

                        {% if nextSession.name %}
                            <p class="dashboard-card__campaign">
                                {{ nextSession.campaign.name }}
                            </p>
                        {% endif %}

                        <p class="dashboard-card__session-date">
                            {{ nextSession.date|date('d/m/Y') }}
                            ·
                            {{
                                nextSession.period
                                    .translationKey()
                                    |trans({}, 'enums')
                            }}

                            {% if
                                nextSession.startTime
                                and nextSession.endTime
                            %}
                                ·
                                {{
                                    nextSession.startTime
                                    |date('H:i', false)
                                }}
                                →
                                {{
                                    nextSession.endTime
                                    |date('H:i', false)
                                }}
                            {% endif %}
                        </p>
                    </div>

                    <a
                        class="text-link"
                        href="{{ path('campaign_show', {
                            id: nextSession.campaign.id
                        }) }}"
                    >
                        {{ 'next_session.view_campaign'|trans }}
                    </a>
                </div>
            </article>
        {% else %}
            <article
                class="
                    dashboard-card
                    dashboard-card--featured
                "
            >
                <div class="dashboard-card__header">
                    <span class="dashboard-card__icon">
                        ◈
                    </span>

                    <span class="dashboard-card__label">
                        {{ 'next_session.label'|trans }}
                    </span>
                </div>

                <div class="dashboard-card__content">
                    <h2>
                        {{ 'next_session.empty.title'|trans }}
                    </h2>

                    <p>
                        {{ 'next_session.empty.description'|trans }}
                    </p>
                </div>
            </article>
        {% endif %}

        <article class="dashboard-card">
            <div class="dashboard-card__header">
                <span class="dashboard-card__icon">
                    ◆
                </span>

                <span class="dashboard-card__label">
                    {{ 'campaigns.active'|trans }}
                </span>
            </div>

            <div class="dashboard-card__stat">
                {{ campaigns|length }}
            </div>

            <a
                class="text-link"
                href="{{ path('campaign_list') }}"
            >
                {{ 'campaigns.view'|trans }}
            </a>
        </article>

        <a
            class="
                dashboard-card
                dashboard-card--action
            "
            href="{{ path('campaign_create') }}"
        >
            <span class="dashboard-card__action-icon">
                +
            </span>

            <span>
                <strong>
                    {{ 'campaigns.create.title'|trans }}
                </strong>

                <small>
                    {{ 'campaigns.create.description'|trans }}
                </small>
            </span>
        </a>
    </section>

    {% if upcomingSessions is not empty %}
        <section class="content-section">
            <div class="section-heading">
                <div>
                    <p class="page-eyebrow">
                        {{ 'upcoming.eyebrow'|trans }}
                    </p>

                    <h2>
                        {{ 'upcoming.title'|trans }}
                    </h2>
                </div>
            </div>

            <div class="dashboard-session-list">
                {% for session in upcomingSessions %}
                    <a
                        class="dashboard-session-card"
                        href="{{ path('campaign_show', {
                            id: session.campaign.id
                        }) }}"
                    >
                        <div class="dashboard-session-card__date">
                            <strong>
                                {{ session.date|date('d') }}
                            </strong>

                            <span>
                                {{ session.date|date('m/Y') }}
                            </span>
                        </div>

                        <div class="dashboard-session-card__content">
                            <strong>
                                {{
                                    session.name
                                    ?: session.campaign.name
                                }}
                            </strong>

                            {% if session.name %}
                                <span
                                    class="
                                        dashboard-session-card__campaign
                                    "
                                >
                                    {{ session.campaign.name }}
                                </span>
                            {% endif %}

                            <span>
                                {{ session.date|date('d/m/Y') }}
                                ·
                                {{
                                    session.period
                                        .translationKey()
                                        |trans({}, 'enums')
                                }}

                                {% if
                                    session.startTime
                                    and session.endTime
                                %}
                                    ·
                                    {{
                                        session.startTime
                                        |date('H:i', false)
                                    }}
                                    →
                                    {{
                                        session.endTime
                                        |date('H:i', false)
                                    }}
                                {% endif %}
                            </span>
                        </div>

                        <span class="dashboard-session-card__arrow">
                            →
                        </span>
                    </a>
                {% endfor %}
            </div>
        </section>
    {% endif %}

    {% if campaigns is not empty %}
        <section class="content-section">
            <div class="section-heading">
                <div>
                    <p class="page-eyebrow">
                        {{ 'quick_access.eyebrow'|trans }}
                    </p>

                    <h2>
                        {{ 'quick_access.title'|trans }}
                    </h2>
                </div>

                <a
                    class="button button--secondary"
                    href="{{ path('campaign_list') }}"
                >
                    {{ 'quick_access.show_all'|trans }}
                </a>
            </div>

            <div class="campaign-grid">
                {% for campaign in campaigns|slice(0, 3) %}
                    <article
                        class="campaign-card"
                        style="
                            --campaign-color:
                            {{ campaign.color ?? '#c9a85c' }}
                        "
                    >
                        {% if campaign.image %}
                            <div class="campaign-card__media">
                                <img
                                    src="{{ asset(
                                        'uploads/campaigns/'
                                        ~ campaign.image
                                    ) }}"
                                    alt=""
                                >
                            </div>
                        {% endif %}

                        <span class="campaign-card__color"></span>

                        <div class="campaign-card__content">
                            <h3>
                                {{ campaign.name }}
                            </h3>

                            <p>
                                {{
                                    'quick_access.campaign.description'
                                    |trans
                                }}
                            </p>

                            <a
                                class="text-link"
                                href="{{ path('campaign_show', {
                                    id: campaign.id
                                }) }}"
                            >
                                {{
                                    'quick_access.campaign.open'
                                    |trans
                                }}
                            </a>
                        </div>
                    </article>
                {% endfor %}
            </div>
        </section>
    {% endif %}
{% endblock %}
