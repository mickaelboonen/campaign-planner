<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">

        <meta
            name="viewport"
            content="width=device-width, initial-scale=1"
        >

        <title>
            {% block title %}CampaignPlanner{% endblock %}
            — CampaignPlanner
        </title>

        {% block stylesheets %}
            {{ importmap('app') }}
        {% endblock %}
    </head>

    <body class="public-page">
        <header class="public-header">
            <a class="brand" href="{{ path('dashboard') }}">
                {% include 'components/brand.html.twig' %}
            </a>
        </header>

        <main class="public-content">
            {% for message in app.flashes('success') %}
                <div class="flash flash--success">
                    {{ message }}
                </div>
            {% endfor %}

            {% block body %}{% endblock %}
        </main>

        {% include 'components/footer.html.twig' %}
    </body>
</html>
