{% extends 'base.html.twig' %}

{% trans_default_domain 'campaign' %}

{% block title %}
    {{ 'edit.title'|trans({
        '%name%': campaign.name
    }) }}
{% endblock %}

{% block body %}
    {% include 'components/breadcrumb.html.twig' with {
        items: [
            {
                label: 'breadcrumb.campaigns'|trans,
                path: path('campaign_list')
            },
            {
                label: campaign.name,
                path: path('campaign_show', {
                    id: campaign.id
                })
            },
            {
                label: 'edit.breadcrumb'|trans
            }
        ]
    } %}

    {% include 'components/page-header.html.twig' with {
        eyebrow: 'eyebrow'|trans,
        title: 'edit.title'|trans({
            '%name%': campaign.name
        }),
        description: 'edit.description'|trans
    } %}

    {% include 'campaign/_form.html.twig' with {
        form: form,
        campaign: campaign,
        form_title: 'edit.form_title'|trans,
        submit_label: 'edit.submit'|trans,
        cancel_path: path('campaign_show', {
            id: campaign.id
        })
    } %}
{% endblock %}
