{% extends 'base.html.twig' %}

{% trans_default_domain 'campaign' %}

{% block title %}
    {{ campaign.name }}
{% endblock %}

{% block body %}
    {% include 'components/breadcrumb.html.twig' with {
        items: [
            {
                label: 'breadcrumb.campaigns'|trans,
                path: path('campaign_list')
            },
            {
                label: campaign.name
            }
        ]
    } %}

    <section
        class="campaign-hero"
        style="
            --campaign-color:
            {{ campaign.color ?? '#c9a85c' }}
        "
    >
        <div class="campaign-hero__media">
            {% if campaign.image %}
                <img
                    src="{{ asset(
                        'uploads/campaigns/' ~ campaign.image
                    ) }}"
                    alt=""
                >
            {% else %}
                <div class="campaign-hero__placeholder">
                    ◆
                </div>
            {% endif %}
        </div>

        <div class="campaign-hero__overlay"></div>

        <div class="campaign-hero__content">
            <div>
                <p class="page-eyebrow">
                    {{ 'show.active'|trans }}
                </p>

                <h1>
                    {{ campaign.name }}
                </h1>

                <p class="campaign-hero__meta">
                    {{ 'show.created_at'|trans }}
                    {{ campaign.createdAt|date('d/m/Y') }}
                </p>
            </div>

            {% if not campaign.isArchived %}
                <a
                    class="button button--secondary"
                    href="{{ path('campaign_edit', {
                        id: campaign.id
                    }) }}"
                >
                    {{ 'show.edit'|trans }}
                </a>

                <form
                    method="post"
                    action="{{ path('campaign_archive', {
                        id: campaign.id
                    }) }}"
                    onsubmit="return confirm(
                        '{{ 'show.archive_confirm'|trans|e('js') }}'
                    );"
                >
                    <input
                        type="hidden"
                        name="_token"
                        value="{{ csrf_token(
                            'archive-campaign-' ~ campaign.id
                        ) }}"
                    >

                    <button
                        type="submit"
                        class="button button--ghost"
                    >
                        {{ 'show.archive'|trans }}
                    </button>
                </form>
            {% else %}
                <span class="campaign-archive-badge">
                    {{ 'show.archived'|trans }}
                </span>
            {% endif %}
        </div>
    </section>

    {% if not campaign.isArchived %}
        <nav class="campaign-navigation">
            <a
                class="campaign-navigation__item is-active"
                href="{{ path('campaign_show', {
                    id: campaign.id
                }) }}"
            >
                <span class="campaign-navigation__icon">◆</span>

                <span>
                    <strong>
                        {{ 'navigation.participants.title'|trans }}
                    </strong>

                    <small>
                        {{ 'navigation.participants.description'|trans }}
                    </small>
                </span>
            </a>

            <a
                class="campaign-navigation__item"
                href="{{ path('calendar_show', {
                    id: campaign.id
                }) }}"
            >
                <span class="campaign-navigation__icon">▦</span>

                <span>
                    <strong>
                        {{ 'navigation.calendar.title'|trans }}
                    </strong>

                    <small>
                        {{ 'navigation.calendar.description'|trans }}
                    </small>
                </span>
            </a>

            <a
                class="campaign-navigation__item"
                href="{{ path('campaign_notes', {
                    id: campaign.id
                }) }}"
            >
                <span class="campaign-navigation__icon">✦</span>

                <span>
                    <strong>
                        {{ 'navigation.notes.title'|trans }}
                    </strong>

                    <small>
                        {{ 'navigation.notes.description'|trans }}
                    </small>
                </span>
            </a>
        </nav>
    {% endif %}

    <section class="stat-grid">
        {% include 'components/stat-card.html.twig' with {
            label: 'show.stats.participants.label'|trans,
            value: participants|length,
            description:
                'show.stats.participants.description'|trans
        } %}

        {% include 'components/stat-card.html.twig' with {
            label: 'show.stats.upcoming.label'|trans,
            value: upcomingSessions|length,
            description:
                'show.stats.upcoming.description'|trans
        } %}

        {% include 'components/stat-card.html.twig' with {
            label: 'show.stats.played.label'|trans,
            value: pastSessions|length,
            description:
                'show.stats.played.description'|trans
        } %}
    </section>

    <section class="content-section">
        <div class="section-heading">
            <div>
                <p class="page-eyebrow">
                    {{ 'show.upcoming.eyebrow'|trans }}
                </p>

                <h2>
                    {{ 'show.upcoming.title'|trans }}
                </h2>
            </div>

            {% if not campaign.isArchived %}
                <a
                    class="button button--secondary"
                    href="{{ path('calendar_show', {
                        id: campaign.id
                    }) }}"
                >
                    {{ 'show.upcoming.calendar'|trans }}
                </a>
            {% endif %}
        </div>

        {% if upcomingSessions is empty %}
            <div class="campaign-sessions__empty">
                <strong>
                    {{ 'show.upcoming.empty.title'|trans }}
                </strong>

                <span>
                    {{ 'show.upcoming.empty.description'|trans }}
                </span>
            </div>
        {% else %}
            <div class="campaign-session-list">
                {% for session in upcomingSessions %}
                    <article class="campaign-session-card">
                        <div class="campaign-session-card__date">
                            <strong>
                                {{ session.date|date('d') }}
                            </strong>

                            <span>
                                {{ session.date|date('m/Y') }}
                            </span>
                        </div>

                        <div class="campaign-session-card__content">
                            {% if session.name %}
                                <strong
                                    class="campaign-session-card__title"
                                >
                                    {{ session.name }}
                                </strong>
                            {% else %}
                                <strong>
                                    {{ session.date|date('d/m/Y') }}
                                </strong>
                            {% endif %}

                            <span>
                                {{ session.date|date('d/m/Y') }}
                                —
                                {{
                                    session.period
                                        .translationKey()
                                        |trans({}, 'enums')
                                }}
                            </span>

                            {% if session.startTime and session.endTime %}
                                <span
                                    class="campaign-session-card__time"
                                >
                                    {{
                                        session.startTime
                                        |date('H:i', false)
                                    }}
                                    →
                                    {{
                                        session.endTime
                                        |date('H:i', false)
                                    }}
                                </span>
                            {% else %}
                                <span
                                    class="
                                        campaign-session-card__time
                                        is-missing
                                    "
                                >
                                    {{ 'show.upcoming.time_missing'|trans }}
                                </span>
                            {% endif %}
                        </div>

                        {% if loop.first %}
                            <span class="campaign-session-card__badge">
                                {{ 'show.upcoming.next'|trans }}
                            </span>
                        {% endif %}

                        <div class="campaign-session-card__actions">
                            <a
                                class="button button--secondary"
                                href="{{ path(
                                    'campaign_session_edit',
                                    {
                                        id: campaign.id,
                                        session: session.id
                                    }
                                ) }}"
                            >
                                {{
                                    session.startTime
                                    and session.endTime
                                        ? 'show.upcoming.edit'|trans
                                        : 'show.upcoming.define_time'|trans
                                }}
                            </a>

                            <form
                                method="post"
                                action="{{ path(
                                    'campaign_session_cancel',
                                    {
                                        id: campaign.id,
                                        session: session.id
                                    }
                                ) }}"
                                onsubmit="return confirm(
                                    '{{ 'show.upcoming.cancel_confirm'|trans|e('js') }}'
                                );"
                            >
                                <input
                                    type="hidden"
                                    name="_token"
                                    value="{{ csrf_token(
                                        'cancel-session-' ~ session.id
                                    ) }}"
                                >

                                <button
                                    type="submit"
                                    class="button button--ghost"
                                >
                                    {{ 'show.upcoming.cancel'|trans }}
                                </button>
                            </form>
                        </div>
                    </article>
                {% endfor %}
            </div>
        {% endif %}
    </section>

    <section class="content-section">
        <div class="section-heading">
            <div>
                <p class="page-eyebrow">
                    {{ 'show.participants.eyebrow'|trans }}
                </p>

                <h2>
                    {{ 'show.participants.title'|trans }}
                </h2>
            </div>

            {% if not campaign.isArchived %}
                <a
                    class="button button--primary"
                    href="{{ path('participant_new', {
                        id: campaign.id
                    }) }}"
                >
                    {{ 'show.participants.add'|trans }}
                </a>
            {% endif %}
        </div>

        {% if participants is empty %}
            {% include 'components/empty-state.html.twig' with {
                icon: '◆',
                title: 'show.participants.empty.title'|trans,
                message:
                    'show.participants.empty.description'|trans,
                action_label: 'show.participants.add'|trans,
                action_path: path('participant_new', {
                    id: campaign.id
                })
            } %}
        {% else %}
            <div class="participant-grid">
                {% for participant in participants %}
                    {% include 'components/participant-card.html.twig' with {
                        participant: participant,
                        readOnly: campaign.isArchived
                    } %}
                {% endfor %}
            </div>
        {% endif %}
    </section>

    {% if archivedParticipants is not empty %}
        <details class="archived-participants">
            <summary class="archived-participants__summary">
                <span class="archived-participants__summary-label">
                    {{ 'show.participants.archived'|trans }}
                </span>

                <span class="archived-participants__count">
                    {{ archivedParticipants|length }}
                </span>
            </summary>

            <div class="archived-participants__grid">
                {% for participant in archivedParticipants %}
                    <article class="archived-participant-card">
                        <div class="archived-participant-card__avatar">
                            {{ participant.name|slice(0, 1)|upper }}
                        </div>

                        <div class="archived-participant-card__content">
                            <div>
                                <h3
                                    class="
                                        archived-participant-card__name
                                    "
                                >
                                    {{ participant.name }}
                                </h3>

                                {% if participant.characterName %}
                                    <p
                                        class="
                                            archived-participant-card__character
                                        "
                                    >
                                        {{ participant.characterName }}
                                    </p>
                                {% endif %}
                            </div>

                            <span
                                class="
                                    archived-participant-card__email
                                "
                            >
                                {{ participant.email }}
                            </span>
                        </div>

                        <form
                            method="post"
                            action="{{ path(
                                'participant_restore',
                                {
                                    id: campaign.id,
                                    participant: participant.id
                                }
                            ) }}"
                        >
                            <input
                                type="hidden"
                                name="_token"
                                value="{{ csrf_token(
                                    'restore-participant-'
                                    ~ participant.id
                                ) }}"
                            >

                            <button
                                type="submit"
                                class="button button--secondary"
                            >
                                {{ 'show.participants.restore'|trans }}
                            </button>
                        </form>
                    </article>
                {% endfor %}
            </div>
        </details>
    {% endif %}

    <section class="content-section">
        <div class="section-heading">
            <div>
                <p class="page-eyebrow">
                    {{ 'show.history.eyebrow'|trans }}
                </p>

                <h2>
                    {{ 'show.history.title'|trans }}
                </h2>
            </div>
        </div>

        {% if pastSessions is empty %}
            <div class="campaign-sessions__empty">
                <strong>
                    {{ 'show.history.empty'|trans }}
                </strong>
            </div>
        {% else %}
            <div class="campaign-session-history">
                {% for session in pastSessions %}
                    <div class="campaign-session-history__item">
                        <span>
                            {{ session.date|date('d/m/Y') }}
                        </span>

                        <strong>
                            {{
                                session.period
                                    .translationKey()
                                    |trans({}, 'enums')
                            }}
                        </strong>
                    </div>
                {% endfor %}
            </div>
        {% endif %}
    </section>
{% endblock %}
