{% extends 'base.html.twig' %}

{% block title %}
    {{ campaign.name }}
{% endblock %}

{% block body %}
    {% include 'components/breadcrumb.html.twig' with {
        items: [
            {
                label: 'Campagnes',
                path: path('campaign_list')
            },
            {
                label: campaign.name
            }
        ]
    } %}

    <section
        class="campaign-hero"
        style="--campaign-color: {{ campaign.color ?? '#c9a85c' }}"
    >
        <div class="campaign-hero__media">
            {% if campaign.image %}
                <img
                    src="{{ asset(
                        'uploads/campaigns/' ~ campaign.image
                    ) }}"
                    alt=""
                >
            {% else %}
                <div class="campaign-hero__placeholder">
                    ◆
                </div>
            {% endif %}
        </div>

        <div class="campaign-hero__overlay"></div>

        <div class="campaign-hero__content">
            <div>
                <p class="page-eyebrow">
                    Campagne active
                </p>

                <h1>
                    {{ campaign.name }}
                </h1>

                <p class="campaign-hero__meta">
                    Créée le
                    {{ campaign.createdAt|date('d/m/Y') }}
                </p>
            </div>

            <a
                class="button button--secondary"
                href="{{ path('campaign_edit', {
                    id: campaign.id
                }) }}"
            >
                Modifier
            </a>
        </div>
    </section>

    <nav class="campaign-navigation">
        <a
            class="campaign-navigation__item is-active"
            href="{{ path('campaign_show', {
                id: campaign.id
            }) }}"
        >
            <span class="campaign-navigation__icon">◆</span>

            <span>
                <strong>Participants</strong>
                <small>Gérer le groupe de jeu</small>
            </span>
        </a>

        <a
            class="campaign-navigation__item"
            href="{{ path('calendar_show', {
                id: campaign.id
            }) }}"
        >
            <span class="campaign-navigation__icon">▦</span>

            <span>
                <strong>Calendrier</strong>
                <small>Disponibilités et créneaux</small>
            </span>
        </a>

        <div class="campaign-navigation__item is-disabled">
            <span class="campaign-navigation__icon">◈</span>

            <span>
                <strong>Sessions</strong>
                <small>Bientôt disponible</small>
            </span>
        </div>
    </nav>

    <section class="stat-grid">
        {% include 'components/stat-card.html.twig' with {
            label: 'Participants',
            value: participants|length,
            description: 'Participants actifs'
        } %}

        {% include 'components/stat-card.html.twig' with {
            label: 'Sessions',
            value: 0,
            description: 'Sessions planifiées'
        } %}

        {% include 'components/stat-card.html.twig' with {
            label: 'Disponibilités',
            value: '—',
            description: 'Calendrier à venir'
        } %}
    </section>

    <section class="content-section">
        <div class="section-heading">
            <div>
                <p class="page-eyebrow">
                    Groupe de jeu
                </p>

                <h2>
                    Participants
                </h2>
            </div>

            <a
                class="button button--primary"
                href="{{ path('participant_new', {
                    id: campaign.id
                }) }}"
            >
                Ajouter un participant
            </a>
        </div>

        {% if participants is empty %}
            {% include 'components/empty-state.html.twig' with {
                icon: '◆',
                title: 'Aucun participant',
                message: 'Ajoutez votre premier joueur afin de commencer à préparer le calendrier de cette campagne.',
                action_label: 'Ajouter un participant',
                action_path: path('participant_new', {
                    id: campaign.id
                })
            } %}
        {% else %}
            <div class="participant-grid">
                {% for participant in participants %}
                    {% include 'components/participant-card.html.twig' with {
                        participant: participant
                    } %}
                {% endfor %}
            </div>
        {% endif %}
    </section>
{% endblock %}
