{% extends 'base.html.twig' %}

{% block title %}
    {{ campaign.name }}
{% endblock %}

{% block body %}
    {% include 'components/breadcrumb.html.twig' with {
        items: [
            {
                label: 'Campagnes',
                path: path('campaign_list')
            },
            {
                label: campaign.name
            }
        ]
    } %}

    <section
        class="campaign-hero"
        style="--campaign-color: {{ campaign.color ?? '#c9a85c' }}"
    >
        <div class="campaign-hero__media">
            {% if campaign.image %}
                <img
                    src="{{ asset(
                        'uploads/campaigns/' ~ campaign.image
                    ) }}"
                    alt=""
                >
            {% else %}
                <div class="campaign-hero__placeholder">
                    ◆
                </div>
            {% endif %}
        </div>

        <div class="campaign-hero__overlay"></div>

        <div class="campaign-hero__content">
            <div>
                <p class="page-eyebrow">
                    Campagne active
                </p>

                <h1>
                    {{ campaign.name }}
                </h1>

                <p class="campaign-hero__meta">
                    Créée le
                    {{ campaign.createdAt|date('d/m/Y') }}
                </p>
            </div>

            {% if not campaign.isArchived %}
                <a
                    class="button button--secondary"
                    href="{{ path('campaign_edit', {
                        id: campaign.id
                    }) }}"
                >
                    Modifier
                </a>


                <form
                    method="post"
                    action="{{ path('campaign_archive', {
                        id: campaign.id
                    }) }}"
                    onsubmit="return confirm(
                        'Archiver cette campagne ?'
                    );"
                >
                    <input
                        type="hidden"
                        name="_token"
                        value="{{ csrf_token(
                            'archive-campaign-' ~ campaign.id
                        ) }}"
                    >

                    <button
                        type="submit"
                        class="button button--ghost"
                    >
                        Archiver
                    </button>
                </form>
            {% else %}
                <span class="campaign-archive-badge">
                    Campagne archivée
                </span>
            {% endif %}
        </div>
    </section>

    {% if not campaign.isArchived %}
        <nav class="campaign-navigation">
            <a
                class="campaign-navigation__item is-active"
                href="{{ path('campaign_show', {
                    id: campaign.id
                }) }}"
            >
                <span class="campaign-navigation__icon">◆</span>

                <span>
                    <strong>Participants</strong>
                    <small>Gérer le groupe de jeu</small>
                </span>
            </a>

            <a
                class="campaign-navigation__item"
                href="{{ path('calendar_show', {
                    id: campaign.id
                }) }}"
            >
                <span class="campaign-navigation__icon">▦</span>

                <span>
                    <strong>Calendrier</strong>
                    <small>Disponibilités et créneaux</small>
                </span>
            </a>

            <div class="campaign-navigation__item is-disabled">
                <span class="campaign-navigation__icon">◈</span>

                <span>
                    <strong>Sessions</strong>
                    <small>Bientôt disponible</small>
                </span>
            </div>
        </nav>
    {% endif %}

    <section class="stat-grid">
        {% include 'components/stat-card.html.twig' with {
            label: 'Participants',
            value: participants|length,
            description: 'Participants actifs'
        } %}

        {% include 'components/stat-card.html.twig' with {
            label: 'Sessions à venir',
            value: upcomingSessions|length,
            description: 'Sessions planifiées'
        } %}

        {% include 'components/stat-card.html.twig' with {
            label: 'Sessions jouées',
            value: pastSessions|length,
            description: 'Historique de la campagne'
        } %}
    </section>

    <section class="content-section">
        <div class="section-heading">
            <div>
                <p class="page-eyebrow">
                    Planning
                </p>

                <h2>
                    Sessions à venir
                </h2>
            </div>

            {% if not campaign.isArchived %}
                <a
                    class="button button--secondary"
                    href="{{ path('calendar_show', {
                        id: campaign.id
                    }) }}"
                >
                    Voir le calendrier
                </a>
            {% endif %}
        </div>

        {% if upcomingSessions is empty %}
            <div class="campaign-sessions__empty">
                <strong>
                    Aucune session planifiée
                </strong>

                <span>
                    Consultez les disponibilités pour choisir une prochaine date.
                </span>
            </div>
        {% else %}
            <div class="campaign-session-list">
                {% for session in upcomingSessions %}
                    <article class="campaign-session-card">
                        <div class="campaign-session-card__date">
                            <strong>
                                {{ session.date|date('d') }}
                            </strong>

                            <span>
                                {{ session.date|date('m/Y') }}
                            </span>
                        </div>

                        <div class="campaign-session-card__content">
                            <strong>
                                {{ session.date|date('d/m/Y') }}
                            </strong>

                            <span>
                                {{ session.period.label() }}
                            </span>
                        </div>

                        {% if loop.first %}
                            <span class="campaign-session-card__badge">
                                Prochaine session
                            </span>
                        {% endif %}

                        <form
                            method="post"
                            action="{{ path('campaign_session_cancel', {
                                id: campaign.id,
                                session: session.id
                            }) }}"
                            onsubmit="return confirm(
                                'Voulez-vous vraiment annuler cette session ?'
                            );"
                        >
                            <input
                                type="hidden"
                                name="_token"
                                value="{{ csrf_token(
                                    'cancel-session-' ~ session.id
                                ) }}"
                            >

                            <button
                                type="submit"
                                class="button button--ghost"
                            >
                                Annuler la session
                            </button>
                        </form>
                    </article>
                {% endfor %}
            </div>
        {% endif %}
    </section>

    <section class="content-section">
        <div class="section-heading">
            <div>
                <p class="page-eyebrow">
                    Historique
                </p>

                <h2>
                    Sessions passées
                </h2>
            </div>
        </div>

        {% if pastSessions is empty %}
            <div class="campaign-sessions__empty">
                <strong>
                    Aucune session passée
                </strong>
            </div>
        {% else %}
            <div class="campaign-session-history">
                {% for session in pastSessions %}
                    <div class="campaign-session-history__item">
                        <span>
                            {{ session.date|date('d/m/Y') }}
                        </span>

                        <strong>
                            {{ session.period.label() }}
                        </strong>
                    </div>
                {% endfor %}
            </div>
        {% endif %}
    </section>

    <section class="content-section">
        <div class="section-heading">
            <div>
                <p class="page-eyebrow">
                    Groupe de jeu
                </p>

                <h2>
                    Participants
                </h2>
            </div>

            {% if not campaign.isArchived %}
                <a
                    class="button button--primary"
                    href="{{ path('participant_new', {
                        id: campaign.id
                    }) }}"
                >
                    Ajouter un participant
                </a>
            {% endif %}
        </div>

        {% if participants is empty %}
            {% include 'components/empty-state.html.twig' with {
                icon: '◆',
                title: 'Aucun participant',
                message: 'Ajoutez votre premier joueur afin de commencer à préparer le calendrier de cette campagne.',
                action_label: 'Ajouter un participant',
                action_path: path('participant_new', {
                    id: campaign.id
                })
            } %}
        {% else %}
            <div class="participant-grid">
                {% for participant in participants %}
                    {% include 'components/participant-card.html.twig' with {
                        participant: participant,
                        readOnly: campaign.isArchived
                    } %}
                {% endfor %}
            </div>
        {% endif %}
    </section>
{% endblock %}
