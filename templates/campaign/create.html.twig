{% extends 'base.html.twig' %}

{% block title %}
    Nouvelle campagne
{% endblock %}

{% block body %}
    {% include 'components/breadcrumb.html.twig' with {
        items: [
            {
                label: 'Campagnes',
                path: path('campaign_list')
            },
            {
                label: 'Nouvelle campagne'
            }
        ]
    } %}

    {% include 'components/page-header.html.twig' with {
        eyebrow: 'Campagne',
        title: 'Nouvelle campagne',
        description: 'Créez un nouvel espace pour organiser votre groupe et vos sessions.'
    } %}

    {% include 'campaign/_form.html.twig' with {
        form: form,
        form_title: 'Créer une campagne',
        submit_label: 'Créer la campagne',
        cancel_path: path('campaign_list')
    } %}
{% endblock %}
