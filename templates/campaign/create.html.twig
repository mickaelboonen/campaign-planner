{% extends 'base.html.twig' %}

{% trans_default_domain 'campaign' %}

{% block title %}
    {{ 'create.title'|trans }}
{% endblock %}

{% block body %}
    {% include 'components/breadcrumb.html.twig' with {
        items: [
            {
                label: 'breadcrumb.campaigns'|trans,
                path: path('campaign_list')
            },
            {
                label: 'create.title'|trans
            }
        ]
    } %}

    {% include 'components/page-header.html.twig' with {
        eyebrow: 'eyebrow'|trans,
        title: 'create.title'|trans,
        description: 'create.description'|trans
    } %}

    {% include 'campaign/_form.html.twig' with {
        form: form,
        form_title: 'create.form_title'|trans,
        submit_label: 'create.submit'|trans,
        cancel_path: path('campaign_list')
    } %}
{% endblock %}
