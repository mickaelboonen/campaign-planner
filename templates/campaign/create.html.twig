{% extends 'base.html.twig' %}

{% block title %}Nouvelle campagne{% endblock %}

{% block body %}
    <h1>Créer une campagne</h1>

    {{ form_start(form) }}
        {{ form_row(form.name, {
            label: 'Nom de la campagne'
        }) }}

        {{ form_row(form.color, {
            label: 'Couleur'
        }) }}

        <button type="submit">
            Créer la campagne
        </button>
    {{ form_end(form) }}

    <a href="{{ path('campaign_list') }}">
        Retour aux campagnes
    </a>
{% endblock %}