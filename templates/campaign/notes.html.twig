{% extends 'base.html.twig' %}

{% trans_default_domain 'campaign' %}

{% block title %}
    {{ 'notes.title'|trans({
        '%name%': campaign.name
    }) }}
{% endblock %}

{% block body %}
    {% include 'components/breadcrumb.html.twig' with {
        items: [
            {
                label: 'breadcrumb.campaigns'|trans,
                path: path('campaign_list')
            },
            {
                label: campaign.name,
                path: path('campaign_show', {
                    id: campaign.id
                })
            },
            {
                label: 'notes.breadcrumb'|trans
            }
        ]
    } %}

    <div class="section-heading">
        <div>
            <p class="page-eyebrow">
                {{ 'notes.eyebrow'|trans }}
            </p>

            <h1>
                {{ 'notes.heading'|trans }}
            </h1>

            <p class="campaign-notes__subtitle">
                {{ campaign.name }}
            </p>
        </div>
    </div>

    <nav class="campaign-navigation">
        <a
            class="campaign-navigation__item"
            href="{{ path('campaign_show', {
                id: campaign.id
            }) }}"
        >
            <span class="campaign-navigation__icon">◆</span>

            <span>
                <strong>
                    {{ 'navigation.participants.title'|trans }}
                </strong>

                <small>
                    {{ 'navigation.participants.description'|trans }}
                </small>
            </span>
        </a>

        <a
            class="campaign-navigation__item"
            href="{{ path('calendar_show', {
                id: campaign.id
            }) }}"
        >
            <span class="campaign-navigation__icon">▦</span>

            <span>
                <strong>
                    {{ 'navigation.calendar.title'|trans }}
                </strong>

                <small>
                    {{ 'navigation.calendar.description'|trans }}
                </small>
            </span>
        </a>

        <a
            class="campaign-navigation__item is-active"
            href="{{ path('campaign_notes', {
                id: campaign.id
            }) }}"
        >
            <span class="campaign-navigation__icon">✦</span>

            <span>
                <strong>
                    {{ 'navigation.notes.title'|trans }}
                </strong>

                <small>
                    {{ 'navigation.notes.description'|trans }}
                </small>
            </span>
        </a>
    </nav>

    <section class="campaign-notes">
        <div class="campaign-notes__editor">
            <div class="campaign-notes__header">
                <div>
                    <h2>
                        {{ 'notes.editor.title'|trans }}
                    </h2>

                    <p>
                        {{ 'notes.editor.description'|trans }}
                    </p>
                </div>
            </div>

            {{ form_start(form, {
                attr: {
                    class: 'campaign-notes__form',
                    'data-turbo': 'false'
                }
            }) }}

                <div class="campaign-notes__field">
                    {{ form_label(form.privateNotes) }}
                    {{ form_widget(form.privateNotes) }}
                    {{ form_errors(form.privateNotes) }}
                </div>

                <div class="campaign-notes__help">
                    {{ 'notes.editor.markdown'|trans }}
                    <code>## Titre</code>,
                    <code>**gras**</code>,
                    <code>- liste</code>.
                </div>

                <div class="campaign-notes__actions">
                    <a
                        class="button button--secondary"
                        href="{{ path('campaign_show', {
                            id: campaign.id
                        }) }}"
                    >
                        {{ 'notes.editor.back'|trans }}
                    </a>

                    <button
                        class="button button--primary"
                        type="submit"
                    >
                        {{ 'notes.editor.save'|trans }}
                    </button>
                </div>

            {{ form_end(form) }}
        </div>

        <aside class="campaign-notes__preview">
            <div class="campaign-notes__header">
                <div>
                    <h2>
                        {{ 'notes.preview.title'|trans }}
                    </h2>

                    <p>
                        {{ 'notes.preview.description'|trans }}
                    </p>
                </div>
            </div>

            <div class="campaign-notes__rendered">
                {{ campaign.privateNotes|markdown }}
            </div>
        </aside>
    </section>
{% endblock %}
