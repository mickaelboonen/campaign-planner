{% extends 'base.html.twig' %}

{% trans_default_domain 'campaign' %}

{% block title %}
    {{ 'list.title'|trans }}
{% endblock %}

{% block body %}
    {% include 'components/page-header.html.twig' with {
        eyebrow: 'list.eyebrow'|trans,
        title: 'list.title'|trans,
        description: 'list.description'|trans,
        action_label: 'list.new'|trans,
        action_path: path('campaign_create')
    } %}

    {% for message in app.flashes('success') %}
        <div class="flash flash--success">
            {{ message }}
        </div>
    {% endfor %}

    {% if campaigns is empty %}
        {% include 'components/empty-state.html.twig' with {
            icon: '◆',
            title: 'list.empty.title'|trans,
            message: 'list.empty.message'|trans,
            action_label: 'list.empty.action'|trans,
            action_path: path('campaign_create')
        } %}
    {% else %}
        <section class="campaign-grid">
            {% for campaign in campaigns %}
                <article
                    class="campaign-card"
                    style="
                        --campaign-color:
                        {{ campaign.color ?? '#c9a85c' }}
                    "
                >
                    <a
                        class="campaign-card__cover"
                        href="{{ path('campaign_show', {
                            id: campaign.id
                        }) }}"
                    >
                        {% if campaign.image %}
                            <img
                                src="{{ asset(
                                    'uploads/campaigns/'
                                    ~ campaign.image
                                ) }}"
                                alt=""
                            >
                        {% else %}
                            <div class="campaign-card__placeholder">
                                <span>◆</span>
                            </div>
                        {% endif %}
                    </a>

                    <div class="campaign-card__body">
                        <div class="campaign-card__heading">
                            <span class="campaign-card__accent"></span>

                            <h2>
                                <a href="{{ path('campaign_show', {
                                    id: campaign.id
                                }) }}">
                                    {{ campaign.name }}
                                </a>
                            </h2>
                        </div>

                        <p class="campaign-card__meta">
                            {{ 'list.created_at'|trans }}
                            {{ campaign.createdAt|date('d/m/Y') }}
                        </p>

                        <div class="campaign-card__actions">
                            <a
                                class="button button--secondary"
                                href="{{ path('campaign_edit', {
                                    id: campaign.id
                                }) }}"
                            >
                                {{ 'list.edit'|trans }}
                            </a>

                            <a
                                class="button button--primary"
                                href="{{ path('campaign_show', {
                                    id: campaign.id
                                }) }}"
                            >
                                {{ 'list.open'|trans }}
                            </a>
                        </div>
                    </div>
                </article>
            {% endfor %}
        </section>
    {% endif %}
{% endblock %}
