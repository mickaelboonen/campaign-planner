{% extends 'base.html.twig' %}

{% trans_default_domain 'game_session' %}

{% block title %}
    {{ 'new.title'|trans }} — {{ campaign.name }}
{% endblock %}

{% block body %}
    {% include 'components/breadcrumb.html.twig' with {
        items: [
            {
                label: 'breadcrumb.campaigns'|trans({}, 'campaign'),
                path: path('campaign_list')
            },
            {
                label: campaign.name,
                path: path('campaign_show', {
                    id: campaign.id
                })
            },
            {
                label: 'new.title'|trans
            }
        ]
    } %}

    {% include 'components/page-header.html.twig' with {
        eyebrow: campaign.name,
        title: 'new.title'|trans,
        description: 'new.description'|trans
    } %}

    {% include 'game_session/_form.html.twig' with {
        campaign: campaign,
        form: form,
        sessionDate: slot.date,
        sessionPeriod: slot.period,
        submitLabel: 'new.submit'|trans
    } %}
{% endblock %}
