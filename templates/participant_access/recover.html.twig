{% extends 'portal_base.html.twig' %}

{% block title %}
    Retrouver mon espace joueur
{% endblock %}

{% block portal_class %}
    portal-page--auth
{% endblock %}

{% block portal_content %}
    <div class="portal-heading">
        <h1>
            Espace joueur
        </h1>

        <p>
            Vous avez perdu votre lien d'accès ?
            Saisissez l'adresse e-mail utilisée
            pour vos campagnes.
        </p>
    </div>

    {% include 'components/flashes.html.twig' %}

    <form
        method="post"
        class="form"
    >
        <div class="form-row">
            <label
                class="form-label"
                for="email"
            >
                Adresse e-mail
            </label>

            <input
                class="form-control"
                type="email"
                name="email"
                id="email"
                autocomplete="email"
                required
                autofocus
            >
        </div>

        <input
            type="hidden"
            name="_token"
            value="{{ csrf_token(
                'participant-recover'
            ) }}"
        >

        <button
            class="button button--portal"
            type="submit"
        >
            Retrouver mon espace
        </button>
    </form>

    <div class="portal-back-link">
        <a href="{{ path('app_login') }}">
            ← Retour à la connexion
        </a>
    </div>
{% endblock %}
