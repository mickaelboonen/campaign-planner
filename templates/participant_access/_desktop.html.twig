{% trans_default_domain 'participant_access' %}

<section class="calendar-card">
    <div class="availability-table">
        <div class="availability-table__corner">{{ 'calendar.table.participant'|trans }}</div>

        {% for day in calendar.days %}
            {% set hasSelectedSession = day.afternoonSlot.isSelected or day.eveningSlot.isSelected %}
            <div class="availability-table__day {{ hasSelectedSession ? 'has-session' }}">
                <strong>{{ day.label }}</strong>
                <span>{{ day.date|date('d/m') }}</span>
            </div>
        {% endfor %}

        <div class="availability-table__subheader"></div>

        {% include 'participant_access/_desktop_periods.html.twig' %}

        {% for row in calendar.rows %}
            {% include 'participant_access/_participant_row.html.twig' with { row: row } %}
        {% else %}
            <div class="availability-table__empty">{{ 'calendar.table.no_participant_campaign'|trans }}</div>
        {% endfor %}

        {% include 'components/calendar/_results.html.twig' %}
    </div>
</section>
