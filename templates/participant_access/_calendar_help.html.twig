{% trans_default_domain 'participant_access' %}

<div
    class="calendar-help"
    data-calendar-help-target="overlay"
    hidden
>
    <aside
        class="calendar-help__panel"
        role="dialog"
        aria-modal="true"
        aria-label="{{ 'help.dialog'|trans }}"
    >
        <header class="calendar-help__header">
            <span
                class="calendar-help__counter"
                data-calendar-help-target="counter"
            ></span>

            <button
                type="button"
                class="calendar-help__close"
                data-action="calendar-help#close"
                aria-label="{{ 'help.close'|trans }}"
            >
                ×
            </button>
        </header>

        <div
            data-calendar-help-target="step"
            data-highlight-desktop=".calendar-card"
            data-highlight-mobile=".calendar-mobile-day"
        >
            <p class="page-eyebrow">{{ 'help.calendar.eyebrow'|trans }}</p>
            <h2>{{ 'help.calendar.title'|trans }}</h2>

            <p class="calendar-help__desktop-text">
                {{ 'help.calendar.desktop'|trans }}
            </p>

            <p class="calendar-help__mobile-text">
                {{ 'help.calendar.mobile'|trans }}
            </p>

            <p>
                {{ 'help.calendar.cycle'|trans }}
            </p>
        </div>

        <div
            data-calendar-help-target="step"
            data-highlight-desktop=".availability-editor"
            data-highlight-mobile=".availability-editor"
            hidden
        >
            <p class="page-eyebrow">{{ 'help.shortcuts.eyebrow'|trans }}</p>
            <h2>{{ 'help.shortcuts.title'|trans }}</h2>

            <p>
                {{ 'help.shortcuts.description'|trans }}
            </p>
        </div>

        <div
            data-calendar-help-target="step"
            data-highlight-desktop=".availability-save"
            data-highlight-mobile=".availability-save"
            hidden
        >
            <p class="page-eyebrow">{{ 'help.autosave.eyebrow'|trans }}</p>
            <h2>{{ 'help.autosave.title'|trans }}</h2>

            <p>
                {{ 'help.autosave.description'|trans }}
            </p>
        </div>

        <footer class="calendar-help__actions">
            <button
                type="button"
                class="button button--secondary"
                data-calendar-help-target="previousButton"
                data-action="calendar-help#previous"
            >
                ← {{ 'help.previous'|trans }}
            </button>

            <button
                type="button"
                class="button button--primary"
                data-calendar-help-target="nextButton"
                data-action="calendar-help#next"
            >
                {{ 'help.next'|trans }} →
            </button>
        </footer>
    </aside>
</div>
