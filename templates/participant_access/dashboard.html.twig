{% extends 'public_base.html.twig' %}
{% trans_default_domain 'participant_access' %}

{% block title %}{{ 'dashboard.title'|trans }}{% endblock %}

{% block body %}
<section class="participant-dashboard-hero">
    <div class="participant-dashboard-hero__content">
        <p class="page-eyebrow">{{ 'dashboard.eyebrow'|trans }}</p>
        <h1>{{ 'dashboard.hello'|trans({ '%name%': participant.name }) }}</h1>
        <p>{{ 'dashboard.description'|trans }}</p>
    </div>
</section>

<section class="participant-dashboard-grid">
    <article class="participant-dashboard-card participant-dashboard-card--featured">
        <p class="page-eyebrow">{{ 'dashboard.next_session.eyebrow'|trans }}</p>

        {% if nextSession %}
            <h2>{{ nextSession.name ?: nextSession.campaign.name }}</h2>

            {% if nextSession.name %}
                <p class="participant-dashboard-card__campaign">{{ nextSession.campaign.name }}</p>
            {% endif %}

            <p class="participant-dashboard-card__date">
                {{ nextSession.date|format_date(pattern: 'EEEE d MMMM yyyy') }}
            </p>

            <p class="participant-dashboard-card__period">
                {{ nextSession.period.translationKey()|trans({}, 'enums') }}
                {% if nextSession.startTime and nextSession.endTime %}
                    · {{ nextSession.startTime|date('H:i', false) }} → {{ nextSession.endTime|date('H:i', false) }}
                {% endif %}
            </p>
        {% else %}
            <h2>{{ 'dashboard.next_session.empty_title'|trans }}</h2>
            <p>{{ 'dashboard.next_session.empty_description'|trans }}</p>
        {% endif %}
    </article>

    <article class="participant-dashboard-card">
        <p class="page-eyebrow">{{ 'dashboard.campaigns.eyebrow'|trans }}</p>
        <h2>{{ participations|length }}</h2>
        <p>
            {{ participations|length > 1
                ? 'dashboard.campaigns.plural'|trans
                : 'dashboard.campaigns.singular'|trans
            }}
        </p>
    </article>
</section>

{% if upcomingSessions is not empty %}
<section class="content-section">
    <div class="section-heading">
        <div>
            <p class="page-eyebrow">{{ 'dashboard.upcoming.eyebrow'|trans }}</p>
            <h2>{{ 'dashboard.upcoming.title'|trans }}</h2>
        </div>
    </div>

    <div class="participant-session-list">
        {% for session in upcomingSessions %}
            <article class="participant-session-card">
                <div class="participant-session-card__date">
                    <strong>{{ session.date|date('d') }}</strong>
                    <span>{{ session.date|date('m/Y') }}</span>
                </div>

                <div class="participant-session-card__content">
                    <strong>{{ session.name ?: session.campaign.name }}</strong>

                    {% if session.name %}
                        <span class="participant-session-card__campaign">{{ session.campaign.name }}</span>
                    {% endif %}

                    <span>
                        {{ session.date|format_date(pattern: 'EEEE d MMMM') }}
                        · {{ session.period.translationKey()|trans({}, 'enums') }}
                        {% if session.startTime and session.endTime %}
                            · {{ session.startTime|date('H:i', false) }} → {{ session.endTime|date('H:i', false) }}
                        {% endif %}
                    </span>
                </div>
            </article>
        {% endfor %}
    </div>
</section>
{% endif %}

<section class="content-section">
    <div class="section-heading">
        <div>
            <p class="page-eyebrow">{{ 'dashboard.access.eyebrow'|trans }}</p>
            <h2>{{ 'dashboard.access.title'|trans }}</h2>
        </div>
    </div>

    <div class="participant-campaign-grid">
        {% for item in participations %}
            <article class="participant-campaign-card" style="--campaign-color: {{ item.campaign.color ?? '#c9a85c' }}">
                {% if item.campaign.image %}
                    <div class="participant-campaign-card__media">
                        <img src="{{ asset('uploads/campaigns/' ~ item.campaign.image) }}" alt="">
                    </div>
                {% endif %}

                <div class="participant-campaign-card__content">
                    <p class="page-eyebrow">{{ 'dashboard.access.campaign'|trans }}</p>
                    <h3>{{ item.campaign.name }}</h3>

                    {% if item.participant.characterName %}
                        <p class="participant-campaign-card__character">{{ item.participant.characterName }}</p>
                    {% endif %}

                    <a class="button button--primary" href="{{ path('participant_availability_show', { token: item.participant.accessToken }) }}">
                        {{ 'dashboard.access.button'|trans }}
                    </a>
                </div>
            </article>
        {% endfor %}
    </div>
</section>
{% endblock %}
