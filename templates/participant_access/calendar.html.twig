{% extends 'public_base.html.twig' %}
{% trans_default_domain 'participant_access' %}

{% block title %}{{ 'calendar.title'|trans({ '%campaign%': campaign.name }) }}{% endblock %}

{% block body %}
<div
    data-controller="calendar-help"
    data-calendar-help-auto-open-value="{{ shouldAutoOpenHelp ? 'true' : 'false' }}"
    data-calendar-help-next-label-value="{{ 'help.next'|trans }}"
    data-calendar-help-finish-label-value="{{ 'help.finish'|trans }}"
>
    {% include 'components/page-header.html.twig' with {
        eyebrow: campaign.name,
        title: 'calendar.hello'|trans({ '%name%': participant.name }),
        description: 'calendar.description'|trans({
            '%start%': calendar.start|date('d/m/Y'),
            '%end%': calendar.end|date('d/m/Y')
        })
    } %}

    {% include 'participant_access/_toolbar.html.twig' %}

    <form
        {% if not isPastWeek %}
            method="post"
            action="{{ path('participant_availability_save', { token: participant.accessToken }) }}"
            data-controller="availability-grid"
            data-action="submit->availability-grid#submit"
            data-availability-grid-available-label-value="{{ 'availability_status.available'|trans({}, 'enums') }}"
            data-availability-grid-maybe-label-value="{{ 'availability_status.maybe'|trans({}, 'enums') }}"
            data-availability-grid-unavailable-label-value="{{ 'availability_status.unavailable'|trans({}, 'enums') }}"
            data-availability-grid-unanswered-label-value="{{ 'availability_status.unanswered'|trans({}, 'enums') }}"
            data-availability-grid-unsaved-changes-message-value="{{ 'calendar.unsaved_changes'|trans }}"
        {% endif %}
    >
        {% if not isPastWeek %}
            <input type="hidden" name="_token" value="{{ csrf_token('save-availabilities-' ~ participant.id) }}">
            <input type="hidden" name="week" value="{{ calendar.start|date('Y-m-d') }}">
        {% endif %}

        {% include 'participant_access/_editor.html.twig' %}

        <div class="calendar-desktop">{% include 'participant_access/_desktop.html.twig' %}</div>
        <div class="calendar-mobile">{% include 'participant_access/_mobile.html.twig' %}</div>

        {% include 'participant_access/_save.html.twig' %}
    </form>

    {% include 'participant_access/_calendar_help.html.twig' %}
</div>
{% endblock %}
