{% extends 'portal_base.html.twig' %}

{% block title %}
    Pierre de communication
{% endblock %}

{% block portal_class %}
    portal-page--feedback
{% endblock %}

{% block portal_content %}
    <div class="portal-heading">
        <h1>
            Pierre de communication
        </h1>

        <p>
            Une question, un problème ou une idée ?
            <br>
            Confiez votre message à la pierre.
            Il parviendra à l'administrateur.
        </p>
    </div>

    {% include 'components/flashes.html.twig' %}

    {{ form_start(form, { attr: { class: 'form' } }) }}

        <div class="form-row">
            {{ form_label(
                form.type,
                null,
                {
                    label_attr: {
                        class: 'form-label'
                    }
                }
            ) }}

            {{ form_widget(
                form.type,
                {
                    attr: {
                        class: 'form-control form-control--select'
                    }
                }
            ) }}

            {{ form_errors(form.type) }}
        </div>

        <div class="form-row">
            {{ form_label(
                form.email,
                null,
                {
                    label_attr: {
                        class: 'form-label'
                    }
                }
            ) }}

            {{ form_widget(
                form.email,
                {
                    attr: {
                        class: 'form-control',
                        autocomplete: 'email'
                    }
                }
            ) }}

            {{ form_errors(form.email) }}
        </div>

        <div class="form-row">
            {{ form_label(
                form.message,
                null,
                {
                    label_attr: {
                        class: 'form-label'
                    }
                }
            ) }}

            {{ form_widget(
                form.message,
                {
                    attr: {
                        class: 'form-control form-control--textarea',
                        placeholder: 'Décrivez votre problème ou votre idée…'
                    }
                }
            ) }}

            {{ form_errors(form.message) }}
        </div>

        <button
            class="button button--portal"
            type="submit"
        >
            Transmettre le message
        </button>

    {{ form_end(form) }}

    <div class="portal-back-link">
        <a href="{{ path('app_login') }}">
            ← Retour
        </a>
    </div>
{% endblock %}
