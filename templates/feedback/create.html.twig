{% extends 'portal_base.html.twig' %}

{% trans_default_domain 'feedback' %}

{% block title %}
    {{ 'create.title'|trans }}
{% endblock %}

{% block portal_class %}
    portal-page--feedback
{% endblock %}

{% block portal_content %}
    <div class="portal-heading">
        <h1>
            {{ 'create.title'|trans }}
        </h1>

        <p>
            {{ 'create.intro.question'|trans }}
            <br>
            {{ 'create.intro.message'|trans }}
            {{ 'create.intro.destination'|trans }}
        </p>
    </div>

    {% include 'components/flashes.html.twig' %}

    {{ form_start(form, { attr: { class: 'form' } }) }}

        <div class="form-row">
            {{ form_label(
                form.type,
                null,
                {
                    label_attr: {
                        class: 'form-label'
                    }
                }
            ) }}

            {{ form_widget(
                form.type,
                {
                    attr: {
                        class: 'form-control form-control--select'
                    }
                }
            ) }}

            {{ form_errors(form.type) }}
        </div>

        <div class="form-row">
            {{ form_label(
                form.subject,
                null,
                {
                    label_attr: {
                        class: 'form-label'
                    }
                }
            ) }}

            {{ form_widget(
                form.subject,
                {
                    attr: {
                        class: 'form-control'
                    }
                }
            ) }}

            {{ form_errors(form.subject) }}
        </div>

        <div class="form-row">
            {{ form_label(
                form.email,
                null,
                {
                    label_attr: {
                        class: 'form-label'
                    }
                }
            ) }}

            {{ form_widget(
                form.email,
                {
                    attr: {
                        class: 'form-control',
                        autocomplete: 'email'
                    }
                }
            ) }}

            {{ form_errors(form.email) }}
        </div>

        <div class="form-row">
            {{ form_label(
                form.message,
                null,
                {
                    label_attr: {
                        class: 'form-label'
                    }
                }
            ) }}

            {{ form_widget(
                form.message,
                {
                    attr: {
                        class: 'form-control form-control--textarea',
                        placeholder: 'create.message_placeholder'|trans
                    }
                }
            ) }}

            {{ form_errors(form.message) }}
        </div>

        <button
            class="button button--portal"
            type="submit"
        >
            {{ 'create.submit'|trans }}
        </button>

    {{ form_end(form) }}

    <div class="portal-back-link">
        <a href="{{ path('app_login') }}">
            ← {{ 'create.back'|trans }}
        </a>
    </div>
{% endblock %}
