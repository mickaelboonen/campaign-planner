{% extends 'base.html.twig' %}
{% trans_default_domain 'participant' %}

{% block title %}{{ 'edit.title'|trans({ '%name%': participant.name }) }}{% endblock %}

{% block body %}
    {% include 'components/breadcrumb.html.twig' with {
        items: [
            { label: 'breadcrumb.campaigns'|trans({}, 'campaign'), path: path('campaign_list') },
            { label: campaign.name, path: path('campaign_show', { id: campaign.id }) },
            { label: participant.name }
        ]
    } %}

    {% include 'components/page-header.html.twig' with {
        eyebrow: 'eyebrow'|trans,
        title: 'edit.heading'|trans,
        description: 'edit.description'|trans({ '%name%': participant.name })
    } %}

    {% include 'participant/_form.html.twig' with {
        form: form,
        campaign: campaign,
        submitLabel: 'edit.submit'|trans
    } %}
{% endblock %}
