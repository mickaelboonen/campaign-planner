{% extends 'error_base.html.twig' %}

{% trans_default_domain 'error' %}

{% block title %}
    {{ 'generic.title'|trans }}
{% endblock %}

{% block body %}
    <section class="error-page">
        <p class="page-eyebrow">
            {{ 'generic.eyebrow'|trans }}
        </p>

        <h1>
            {{ 'generic.heading'|trans }}
        </h1>

        <p class="error-page__message">
            {{ 'generic.message'|trans }}
        </p>

        <a
            class="button button--primary"
            href="{{ path('dashboard') }}"
        >
            {{ 'common.home'|trans }}
        </a>
    </section>
{% endblock %}
