{% extends 'error_base.html.twig' %}

{% trans_default_domain 'error' %}

{% block title %}
    {{ 'forbidden.title'|trans }}
{% endblock %}

{% block body %}
    <section class="error-page error-page--403">
        <div class="error-page__content error-page__content--403">
            <div class="error-page__code error-page__code--danger">
                403
            </div>

            <div class="error-page__separator error-page__separator--danger">
                <span></span>
                <span class="error-page__separator-icon">◆</span>
                <span></span>
            </div>

            <h1>
                {{ 'forbidden.heading'|trans }}
            </h1>

            <div class="error-page__subtitle">
                {{ 'forbidden.subtitle'|trans }}
            </div>

            <p class="error-page__message">
                {{ 'forbidden.message_line_1'|trans }}<br>
                {{ 'forbidden.message_line_2'|trans }}
            </p>

            <a
                class="error-page__button"
                href="{{ path('dashboard') }}"
            >
                <span class="error-page__button-icon">
                    ◈
                </span>

                {{ 'common.home'|trans }}
            </a>
        </div>
    </section>
{% endblock %}
