{% extends 'error_base.html.twig' %}

{% trans_default_domain 'error' %}

{% block title %}
    {{ 'not_found.title'|trans }}
{% endblock %}

{% block body %}
    <section class="error-page error-page--404">
        <div class="error-page__content error-page__content--404">
            <div class="error-page__code">
                404
            </div>

            <div class="error-page__separator">
                <span></span>
                <span class="error-page__separator-icon">◆</span>
                <span></span>
            </div>

            <h1>
                {{ 'not_found.heading'|trans }}
            </h1>

            <div class="error-page__subtitle error-page__subtitle--mist">
                {{ 'not_found.subtitle'|trans }}
            </div>

            <p class="error-page__message">
                {{ 'not_found.message_line_1'|trans }}<br>
                {{ 'not_found.message_line_2'|trans }}
            </p>

            <a
                class="error-page__button"
                href="{{ path('dashboard') }}"
            >
                <span class="error-page__button-icon">
                    ◈
                </span>

                {{ 'common.home'|trans }}
            </a>
        </div>
    </section>
{% endblock %}
