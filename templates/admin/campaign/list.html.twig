{% extends 'admin/base.html.twig' %}

{% trans_default_domain 'admin' %}

{% block admin_title %}
    {{ 'campaign.title'|trans }}
{% endblock %}

{% block admin_content %}
    <section class="admin-campaigns">
        <header class="admin-page-header">
            <div>
                <h2>
                    {{ 'campaign.title'|trans }}
                </h2>

                <p>
                    {{ 'campaign.description'|trans }}
                </p>
            </div>
        </header>

        <div class="admin-campaigns__toolbar">
            <nav
                class="admin-campaigns__filters"
                aria-label="{{ 'campaign.filters.aria'|trans }}"
            >
                {% set filters = {
                    active: 'campaign.filters.active'|trans,
                    archived: 'campaign.filters.archived'|trans,
                    all: 'campaign.filters.all'|trans
                } %}

                {% for value, label in filters %}
                    <a
                        class="
                            admin-campaigns__filter
                            {{ currentStatus == value ? 'is-active' }}
                        "
                        href="{{ path('admin_campaign_index', {
                            status: value,
                            q: search
                        }) }}"
                    >
                        {{ label }}
                    </a>
                {% endfor %}
            </nav>

            <form
                class="admin-campaigns__search"
                method="get"
            >
                <input
                    type="hidden"
                    name="status"
                    value="{{ currentStatus }}"
                >

                <input
                    type="search"
                    name="q"
                    value="{{ search }}"
                    placeholder="{{ 'campaign.search.placeholder'|trans }}"
                    aria-label="{{ 'campaign.search.aria'|trans }}"
                >

                <button
                    class="button button--secondary"
                    type="submit"
                >
                    {{ 'campaign.search.submit'|trans }}
                </button>

                {% if search %}
                    <a
                        class="admin-campaigns__search-reset"
                        href="{{ path('admin_campaign_index', {
                            status: currentStatus
                        }) }}"
                    >
                        {{ 'campaign.search.clear'|trans }}
                    </a>
                {% endif %}
            </form>
        </div>

        {% if campaigns is empty %}
            <div class="admin-empty-state">
                {{ 'campaign.empty'|trans }}
            </div>
        {% else %}
            <div class="admin-campaigns__table-wrapper">
                <table class="admin-campaigns__table">
                    <thead>
                        <tr>
                            <th>
                                {{ 'campaign.table.campaign'|trans }}
                            </th>

                            <th>
                                {{ 'campaign.table.game_master'|trans }}
                            </th>

                            <th>
                                {{ 'campaign.table.participants'|trans }}
                            </th>

                            <th>
                                {{ 'campaign.table.created_at'|trans }}
                            </th>

                            <th>
                                {{ 'campaign.table.status'|trans }}
                            </th>

                            <th>
                                <span class="sr-only">
                                    {{ 'campaign.table.actions'|trans }}
                                </span>
                            </th>
                        </tr>
                    </thead>

                    <tbody>
                        {% for campaign in campaigns %}
                            <tr>
                                <td>
                                    <div class="admin-campaigns__campaign">
                                        {% if campaign.image %}
                                            <img
                                                src="{{ asset(
                                                    'uploads/campaigns/'
                                                    ~ campaign.image
                                                ) }}"
                                                alt=""
                                                loading="lazy"
                                                decoding="async"
                                            >
                                        {% endif %}

                                        <strong>
                                            {{ campaign.name }}
                                        </strong>
                                    </div>
                                </td>

                                <td>
                                    {{ campaign.owner.userIdentifier }}
                                </td>

                                <td>
                                    {{ campaign.participants|length }}
                                </td>

                                <td>
                                    {{ campaign.createdAt|date('d/m/Y') }}
                                </td>

                                <td>
                                    <span
                                        class="
                                            admin-campaign-status
                                            {{ campaign.archived
                                                ? 'is-archived'
                                                : 'is-active'
                                            }}
                                        "
                                    >
                                        {{
                                            campaign.archived
                                                ? 'campaign.status.archived'|trans
                                                : 'campaign.status.active'|trans
                                        }}
                                    </span>
                                </td>

                                <td class="admin-campaigns__actions">
                                    <a
                                        class="button button--secondary"
                                        href="{{ path(
                                            'admin_campaign_show',
                                            {
                                                id: campaign.id
                                            }
                                        ) }}"
                                    >
                                        {{ 'campaign.table.view'|trans }}
                                    </a>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>

            {% if campaigns.pageCount > 1 %}
                <div class="admin-campaigns__pagination">
                    {{ knp_pagination_render(campaigns) }}
                </div>
            {% endif %}
        {% endif %}
    </section>
{% endblock %}
