{% extends 'admin/base.html.twig' %}

{% trans_default_domain 'admin' %}

{% block admin_title %}
    {{ campaign.name }}
{% endblock %}

{% block admin_breadcrumb %}
    {% include 'components/breadcrumb.html.twig' with {
        items: [
            {
                label: 'campaign.show.breadcrumb_admin'|trans,
                path: path('admin_dashboard')
            },
            {
                label: 'campaign.show.breadcrumb_campaigns'|trans,
                path: path('admin_campaign_index')
            },
            {
                label: campaign.name
            }
        ]
    } %}
{% endblock %}

{% block admin_content %}
    <section class="admin-campaign-detail">
        <div class="admin-campaign-detail__grid">
            <article class="admin-campaign-detail__card">
                <h3>
                    {{ 'campaign.show.campaign.title'|trans }}
                </h3>

                {% if campaign.image %}
                    <img
                        class="admin-campaign-detail__image"
                        src="{{ asset(
                            'uploads/campaigns/' ~ campaign.image
                        ) }}"
                        alt=""
                    >
                {% endif %}

                <dl class="admin-campaign-detail__data">
                    <div>
                        <dt>
                            {{ 'campaign.show.campaign.name'|trans }}
                        </dt>

                        <dd>
                            {{ campaign.name }}
                        </dd>
                    </div>

                    <div>
                        <dt>
                            {{ 'campaign.show.campaign.status'|trans }}
                        </dt>

                        <dd>
                            <span
                                class="
                                    admin-campaign-status
                                    {{ campaign.archived
                                        ? 'is-archived'
                                        : 'is-active'
                                    }}
                                "
                            >
                                {{
                                    campaign.archived
                                        ? 'campaign.status.archived'|trans
                                        : 'campaign.status.active'|trans
                                }}
                            </span>
                        </dd>
                    </div>

                    <div>
                        <dt>
                            {{ 'campaign.show.campaign.created_at'|trans }}
                        </dt>

                        <dd>
                            {{ campaign.createdAt|date('d/m/Y H:i') }}
                        </dd>
                    </div>

                    <div>
                        <dt>
                            {{ 'campaign.show.campaign.participants'|trans }}
                        </dt>

                        <dd>
                            {{ campaign.participants|length }}
                        </dd>
                    </div>

                    <div>
                        <dt>
                            {{ 'campaign.show.campaign.sessions'|trans }}
                        </dt>

                        <dd>
                            {{ campaign.gameSessions|length }}
                        </dd>
                    </div>
                </dl>
            </article>

            <article class="admin-campaign-detail__card">
                <h3>
                    {{ 'campaign.show.owner.title'|trans }}
                </h3>

                <dl class="admin-campaign-detail__data">
                    <div>
                        <dt>
                            {{ 'campaign.show.owner.account'|trans }}
                        </dt>

                        <dd>
                            {{ campaign.owner.userIdentifier }}
                        </dd>
                    </div>

                    <div>
                        <dt>
                            {{ 'campaign.show.owner.account_status'|trans }}
                        </dt>

                        <dd>
                            {{
                                campaign.owner.active
                                    ? 'campaign.show.owner.active'|trans
                                    : 'campaign.show.owner.disabled'|trans
                            }}
                        </dd>
                    </div>

                    <div>
                        <dt>
                            {{ 'campaign.show.owner.plan'|trans }}
                        </dt>

                        <dd>
                            {{
                                campaign.owner.subscriptionPlan
                                    .translationKey()
                                    |trans({}, 'enums')
                            }}
                        </dd>
                    </div>
                </dl>

                <a
                    class="button button--secondary"
                    href="{{ path('admin_user_show', {
                        id: campaign.owner.id
                    }) }}"
                >
                    {{ 'campaign.show.owner.view'|trans }}
                </a>
            </article>
        </div>

        <article class="admin-campaign-detail__card">
            <h3>
                {{ 'campaign.show.participants.title'|trans }}
            </h3>

            {% if campaign.participants is empty %}
                <p class="admin-campaign-detail__empty">
                    {{ 'campaign.show.participants.empty'|trans }}
                </p>
            {% else %}
                <div class="admin-campaign-detail__participants">
                    {% for participant in campaign.participants %}
                        <div class="admin-campaign-detail__participant">
                            <div>
                                <strong>
                                    {{ participant.name }}
                                </strong>

                                {% if participant.characterName %}
                                    <span>
                                        {{ participant.characterName }}
                                    </span>
                                {% endif %}
                            </div>

                            <span>
                                {{ participant.email }}
                            </span>
                        </div>
                    {% endfor %}
                </div>
            {% endif %}
        </article>
    </section>
{% endblock %}
