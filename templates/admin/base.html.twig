{% extends 'base.html.twig' %}

{% block title %}
    Administration — CampaignPlanner
{% endblock %}

{% block body %}
    <div class="admin-layout">
        <aside class="admin-sidebar">
            <div class="admin-sidebar__brand">
                <span class="admin-sidebar__eyebrow">
                    CampaignPlanner
                </span>

                <strong class="admin-sidebar__title">
                    Administration
                </strong>
            </div>

            <nav class="admin-nav">
                <a
                    href="{{ path('admin_dashboard') }}"
                    class="admin-nav__item"
                >
                    Vue d'ensemble
                </a>

                <a
                    href="{{ path('admin_user_list') }}"
                    class="admin-nav__item"
                >
                    Utilisateurs
                </a>

                <a
                    href="#"
                    class="admin-nav__item"
                >
                    Campagnes
                </a>

                <a
                    href="#"
                    class="admin-nav__item"
                >
                    Logs
                </a>
            </nav>

            <div class="admin-sidebar__footer">
                <a href="{{ path('dashboard') }}">
                    ← Retour à CampaignPlanner
                </a>
            </div>
        </aside>

        <main class="admin-main">
            <header class="admin-header">
                <div>
                    <span class="admin-header__eyebrow">
                        Administration
                    </span>

                    <h1>
                        {% block admin_title %}
                            CampaignPlanner
                        {% endblock %}
                    </h1>
                </div>

                {# On réutilise notre switch dark/light #}
                {% include 'components/theme-button.html.twig' %}
            </header>

            <div class="admin-content">
                {% block admin_content %}{% endblock %}
            </div>
        </main>
    </div>
{% endblock %}
