{% extends 'base.html.twig' %}

{% trans_default_domain 'admin' %}

{% block title %}
    {{ 'feedback.show.title'|trans({
        '%id%': feedback.id
    }) }}
{% endblock %}

{% block body %}
    <div class="admin-feedback-detail">
        <div class="page-header">
            <div>
                <p class="page-eyebrow">
                    {{ 'feedback.eyebrow'|trans }}
                </p>

                <h1>
                    {{ 'feedback.show.title'|trans({
                        '%id%': feedback.id
                    }) }}
                </h1>
            </div>

            <a
                class="button button--secondary"
                href="{{ path('admin_feedback_index') }}"
            >
                {{ 'feedback.show.back'|trans }}
            </a>
        </div>

        <div class="admin-feedback-detail__meta">
            <div class="admin-feedback-detail__meta-item">
                <span class="admin-feedback-detail__meta-label">
                    {{ 'feedback.show.meta.type'|trans }}
                </span>

                <strong class="admin-feedback-detail__type">
                    {{
                        feedback.type
                            .translationKey()
                            |trans({}, 'enums')
                    }}
                </strong>
            </div>

            <div class="admin-feedback-detail__meta-item">
                <span class="admin-feedback-detail__meta-label">
                    {{ 'feedback.show.meta.status'|trans }}
                </span>

                <strong
                    class="
                        admin-feedback-detail__status
                        admin-feedback-detail__status--{{ feedback.status.value }}
                    "
                >
                    {{
                        feedback.status
                            .translationKey()
                            |trans({}, 'enums')
                    }}
                </strong>
            </div>

            <div class="admin-feedback-detail__meta-item">
                <span class="admin-feedback-detail__meta-label">
                    {{ 'feedback.show.meta.received_at'|trans }}
                </span>

                <strong>
                    {{ feedback.createdAt|date('d/m/Y H:i') }}
                </strong>
            </div>
        </div>

        <section class="admin-feedback-detail__card">
            <div class="admin-feedback-detail__section">
                <h2>
                    {{ 'feedback.show.sender.title'|trans }}
                </h2>

                <div class="admin-feedback-detail__sender">
                    <span>
                        {{
                            feedback.email
                            ?? 'feedback.show.sender.anonymous'|trans
                        }}
                    </span>

                    {% if feedback.user %}
                        <span class="admin-feedback-detail__muted">
                            {{
                                'feedback.show.sender.account'
                                |trans({
                                    '%id%': feedback.user.id
                                })
                            }}
                        </span>
                    {% endif %}
                </div>
            </div>

            <div class="admin-feedback-detail__section">
                <h2>
                    {{ 'feedback.show.subject'|trans }}
                </h2>

                <div class="admin-feedback-detail__subject">
                    {{ feedback.subject }}
                </div>
            </div>

            <div class="admin-feedback-detail__section">
                <h2>
                    {{ 'feedback.show.message'|trans }}
                </h2>

                <div class="admin-feedback-detail__message">
                    {{ feedback.message }}
                </div>
            </div>
        </section>

        <div class="admin-feedback-detail__actions">
            {% if feedback.email %}
                <a
                    class="button button--secondary"
                    href="mailto:{{ feedback.email }}"
                >
                    {{ 'feedback.show.reply'|trans }}
                </a>
            {% endif %}

            {% if feedback.status.value == 'closed' %}
                <form
                    method="post"
                    action="{{ path('admin_feedback_reopen', {
                        id: feedback.id
                    }) }}"
                >
                    <input
                        type="hidden"
                        name="_token"
                        value="{{ csrf_token(
                            'reopen-feedback-' ~ feedback.id
                        ) }}"
                    >

                    <button
                        type="submit"
                        class="button button--primary"
                    >
                        {{ 'feedback.show.reopen'|trans }}
                    </button>
                </form>
            {% else %}
                <form
                    method="post"
                    action="{{ path('admin_feedback_close', {
                        id: feedback.id
                    }) }}"
                    onsubmit="return confirm(
                        '{{ 'feedback.show.close_confirm'|trans|e('js') }}'
                    );"
                >
                    <input
                        type="hidden"
                        name="_token"
                        value="{{ csrf_token(
                            'close-feedback-' ~ feedback.id
                        ) }}"
                    >

                    <button
                        type="submit"
                        class="button button--primary"
                    >
                        {{ 'feedback.show.close'|trans }}
                    </button>
                </form>
            {% endif %}
        </div>
    </div>
{% endblock %}
