{% extends 'base.html.twig' %}

{% block title %}
    Feedbacks
{% endblock %}

{% block body %}
    <div class="admin-feedbacks">
        <div class="page-header">
            <div>
                <p class="page-eyebrow">Administration</p>
                <h1>Feedbacks</h1>
            </div>
        </div>
        <nav class="admin-feedbacks__filters">
            {% set filters = {
                open: 'À traiter',
                new: 'Nouveaux',
                read: 'Lus',
                closed: 'Clôturés',
                all: 'Tous'
            } %}

            {% for value, label in filters %}
                <a class="admin-feedbacks__filter {{ currentStatus == value ? 'is-active' }}" href="{{ path('admin_feedback_index', { status: value }) }}" >
                    {{ label }}
                    <span class="admin-feedbacks__filter-count">{{ counts[value] }}</span>
                </a>
            {% endfor %}
        </nav>

        {% if feedbacks is empty %}
            <div class="admin-feedbacks__empty">
                Aucun message pour le moment.
            </div>
        {% else %}
            <div class="admin-feedbacks__table-wrapper">
                <table class="admin-feedbacks__table">
                    <thead>
                        <tr>
                            <th>Type</th>
                            <th>Statut</th>
                            <th>Utilisateur</th>
                            <th>Sujet</th>
                            <th>Date</th>
                            <th><span class="sr-only">Actions</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for feedback in feedbacks %}
                            <tr class="admin-feedbacks__row {% if feedback.status.value == 'new' %} admin-feedbacks__row--new {% endif %} ">
                                <td>
                                    <span class="admin-feedbacks__type">{{ feedback.type.label() }}</span>
                                </td>
                                <td>
                                    <span class="admin-feedbacks__status admin-feedbacks__status--{{ feedback.status.value }}">
                                        {{ feedback.status.label() }}
                                    </span>
                                </td>
                                <td>
                                    <div class="admin-feedbacks__author">
                                        <span class="admin-feedbacks__email">{{ feedback.email ?? 'Anonyme' }}</span>

                                        {% if feedback.user %}
                                            <span class="admin-feedbacks__account">Compte #{{ feedback.user.id }}</span>
                                        {% endif %}
                                    </div>
                                </td>
                                <td>
                                    <div class="admin-feedbacks__subject">{{ feedback.subject }}</div>
                                </td>
                                <td>
                                    <span class="admin-feedbacks__date">{{ feedback.createdAt|date('d/m/Y H:i') }}</span>
                                </td>

                                <td class="admin-feedbacks__actions">
                                    <a class="button button--secondary" href="{{ path('admin_feedback_show', { id: feedback.id }) }}" >
                                        Voir
                                    </a>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
                {% if feedbacks.pageCount > 1 %}
                    <div class="admin-feedbacks__pagination">{{ knp_pagination_render(feedbacks) }}</div>
                {% endif %}
            </div>
        {% endif %}
    </div>
{% endblock %}
