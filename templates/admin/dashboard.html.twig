{% extends 'admin/base.html.twig' %}

{% trans_default_domain 'admin' %}

{% block admin_title %}
    {{ 'dashboard.title'|trans }}
{% endblock %}

{% block admin_content %}
    <section class="admin-stats">
        <article class="admin-stat">
            <span class="admin-stat__label">
                {{ 'dashboard.game_masters'|trans }}
            </span>

            <strong class="admin-stat__value">
                {{ userCount }}
            </strong>
        </article>

        <article class="admin-stat">
            <span class="admin-stat__label">
                {{ 'dashboard.campaigns'|trans }}
            </span>

            <strong class="admin-stat__value">
                {{ campaignCount }}
            </strong>
        </article>
    </section>
{% endblock %}
