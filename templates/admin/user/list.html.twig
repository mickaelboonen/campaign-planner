{% extends 'admin/base.html.twig' %}

{% trans_default_domain 'admin' %}

{% block admin_title %}
    {{ 'user.title'|trans }}
{% endblock %}

{% block admin_content %}
    <section class="admin-users">
        <div class="admin-users__toolbar">
            <form
                method="get"
                action="{{ path('admin_user_list') }}"
                class="admin-users__search"
            >
                <input
                    type="search"
                    name="q"
                    value="{{ search }}"
                    placeholder="{{ 'user.search.placeholder'|trans }}"
                >

                <button
                    type="submit"
                    class="button button--secondary"
                >
                    {{ 'user.search.submit'|trans }}
                </button>

                {% if search %}
                    <a
                        href="{{ path('admin_user_list') }}"
                        class="button button--ghost"
                    >
                        {{ 'user.search.reset'|trans }}
                    </a>
                {% endif %}
            </form>
        </div>

        <div class="admin-table-wrapper">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>{{ 'user.table.user'|trans }}</th>
                        <th>{{ 'user.table.plan'|trans }}</th>
                        <th>{{ 'user.table.status'|trans }}</th>
                        <th>{{ 'user.table.campaigns'|trans }}</th>
                        <th>{{ 'user.table.registered_at'|trans }}</th>
                        <th>{{ 'user.table.last_login'|trans }}</th>
                        <th></th>
                    </tr>
                </thead>

                <tbody>
                    {% for user in users %}
                        <tr>
                            <td>
                                <strong>
                                    {{ user.email }}
                                </strong>

                                {% if 'ROLE_ADMIN' in user.roles %}
                                    <span
                                        class="
                                            admin-badge
                                            admin-badge--admin
                                        "
                                    >
                                        {{ 'user.table.admin'|trans }}
                                    </span>
                                {% endif %}
                            </td>

                            <td>
                                <span
                                    class="
                                        admin-badge
                                        {{ user.subscriptionPlan.value
                                            == 'premium'
                                                ? 'admin-badge--premium'
                                                : ''
                                        }}
                                    "
                                >
                                    {{
                                        user.subscriptionPlan
                                            .translationKey()
                                            |trans({}, 'enums')
                                    }}
                                </span>
                            </td>

                            <td>
                                {% if user.active %}
                                    <span
                                        class="
                                            admin-status
                                            admin-status--active
                                        "
                                    >
                                        {{ 'user.table.active'|trans }}
                                    </span>
                                {% else %}
                                    <span
                                        class="
                                            admin-status
                                            admin-status--inactive
                                        "
                                    >
                                        {{ 'user.table.disabled'|trans }}
                                    </span>
                                {% endif %}
                            </td>

                            <td>
                                {{ user.campaigns|length }}
                            </td>

                            <td>
                                {{ user.createdAt|date('d/m/Y') }}
                            </td>

                            <td>
                                {% if user.lastLoginAt %}
                                    {{
                                        user.lastLoginAt
                                        |date('d/m/Y H:i')
                                    }}
                                {% else %}
                                    <span class="text-muted">
                                        {{ 'user.table.never'|trans }}
                                    </span>
                                {% endif %}
                            </td>

                            <td>
                                <a
                                    href="{{ path('admin_user_show', {
                                        id: user.id
                                    }) }}"
                                    class="button button--ghost"
                                >
                                    {{ 'user.table.view'|trans }}
                                </a>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="7">
                                {{ 'user.table.empty'|trans }}
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </section>
{% endblock %}
