{% extends 'admin/base.html.twig' %}

{% trans_default_domain 'admin' %}

{% block admin_title %}
    {{ user.email }}
{% endblock %}

{% block admin_content %}
    <div class="admin-user">
        <section class="admin-user__summary">
            <div class="admin-user__identity">
                <div>
                    <p class="page-eyebrow">
                        {{ 'user.show.game_master'|trans }}
                    </p>

                    <h2>
                        {{ user.email }}
                    </h2>
                </div>

                <div class="admin-user__badges">
                    {% if 'ROLE_ADMIN' in user.roles %}
                        <span
                            class="
                                admin-badge
                                admin-badge--admin
                            "
                        >
                            {{ 'user.show.admin'|trans }}
                        </span>
                    {% endif %}

                    <span
                        class="
                            admin-badge
                            {{ user.subscriptionPlan.value == 'premium'
                                ? 'admin-badge--premium'
                                : ''
                            }}
                        "
                    >
                        {{
                            user.subscriptionPlan
                                .translationKey()
                                |trans({}, 'enums')
                        }}
                    </span>

                    <span
                        class="
                            admin-status
                            {{ user.active
                                ? 'admin-status--active'
                                : 'admin-status--inactive'
                            }}
                        "
                    >
                        {{
                            user.active
                                ? 'user.show.active'|trans
                                : 'user.show.disabled'|trans
                        }}
                    </span>
                </div>
            </div>

            <dl class="admin-user__meta">
                <div>
                    <dt>
                        {{ 'user.show.registered_at'|trans }}
                    </dt>

                    <dd>
                        {{ user.createdAt|date('d/m/Y H:i') }}
                    </dd>
                </div>

                <div>
                    <dt>
                        {{ 'user.show.last_login'|trans }}
                    </dt>

                    <dd>
                        {% if user.lastLoginAt %}
                            {{ user.lastLoginAt|date('d/m/Y H:i') }}
                        {% else %}
                            {{ 'user.show.never'|trans }}
                        {% endif %}
                    </dd>
                </div>

                <div>
                    <dt>
                        {{ 'user.show.campaigns'|trans }}
                    </dt>

                    <dd>
                        {{ user.campaigns|length }}
                    </dd>
                </div>
            </dl>

            {% if user != app.user %}
                <form
                    method="post"
                    action="{{ path('admin_user_toggle_active', {
                        id: user.id
                    }) }}"
                    onsubmit="return confirm(
                        '{{ (
                            user.active
                                ? 'user.show.disable_confirm'
                                : 'user.show.enable_confirm'
                        )|trans|e('js') }}'
                    );"
                >
                    <input
                        type="hidden"
                        name="_token"
                        value="{{ csrf_token(
                            'toggle-user-' ~ user.id
                        ) }}"
                    >

                    <button
                        type="submit"
                        class="
                            button
                            {{ user.active
                                ? 'button--ghost'
                                : 'button--secondary'
                            }}
                        "
                    >
                        {{
                            user.active
                                ? 'user.show.disable'|trans
                                : 'user.show.enable'|trans
                        }}
                    </button>
                </form>
            {% endif %}
        </section>

        <section class="admin-user__campaigns">
            <div class="section-heading">
                <div>
                    <p class="page-eyebrow">
                        {{ 'user.show.activity'|trans }}
                    </p>

                    <h2>
                        {{ 'user.show.campaigns_title'|trans }}
                    </h2>
                </div>
            </div>

            {% if user.campaigns is empty %}
                <div class="admin-user__empty">
                    {{ 'user.show.campaigns_empty'|trans }}
                </div>
            {% else %}
                <div class="admin-user__campaign-list">
                    {% for campaign in user.campaigns %}
                        <article class="admin-user__campaign">
                            <div>
                                <strong>
                                    {{ campaign.name }}
                                </strong>

                                <span>
                                    {{ 'user.show.created_at'|trans }}
                                    {{
                                        campaign.createdAt
                                        |date('d/m/Y')
                                    }}
                                </span>
                            </div>

                            <a
                                href="{{ path('campaign_show', {
                                    id: campaign.id
                                }) }}"
                                class="button button--ghost"
                            >
                                {{ 'user.show.view'|trans }}
                            </a>
                        </article>
                    {% endfor %}
                </div>
            {% endif %}
        </section>
    </div>
{% endblock %}
