{% extends 'admin/base.html.twig' %}

{% trans_default_domain 'admin' %}

{% block admin_title %}
    {{ 'logs.title'|trans }}
{% endblock %}

{% block admin_breadcrumb %}
    {% include 'components/breadcrumb.html.twig' with {
        items: [
            {
                label: 'logs.breadcrumb_admin'|trans,
                path: path('admin_dashboard')
            },
            {
                label: 'logs.title'|trans
            }
        ]
    } %}
{% endblock %}

{% block admin_content %}
    <section class="admin-logs">
        <header class="admin-logs__header">
            <div class="admin-logs__title">
                <strong>
                    {{ 'logs.journal'|trans }}
                </strong>

                <span>
                    {{ 'logs.errors_for'|trans({
                        '%date%': selectedDate|date('d/m/Y')
                    }) }}
                </span>
            </div>

            <div class="admin-logs__navigation">
                <a
                    class="button button--secondary"
                    href="{{ path('admin_log_list', {
                        date: previousDate|date('Y-m-d')
                    }) }}"
                    aria-label="{{ 'logs.navigation.previous'|trans }}"
                >
                    ←
                </a>

                <form
                    method="get"
                    class="admin-logs__date-picker"
                >
                    <label
                        class="sr-only"
                        for="admin-log-date"
                    >
                        {{ 'logs.navigation.choose_date'|trans }}
                    </label>

                    <input
                        id="admin-log-date"
                        type="date"
                        name="date"
                        value="{{ selectedDate|date('Y-m-d') }}"
                        max="{{ 'now'|date('Y-m-d') }}"
                        onchange="this.form.submit()"
                    >
                </form>

                {% if
                    nextDate|date('Y-m-d')
                    <= 'now'|date('Y-m-d')
                %}
                    <a
                        class="button button--secondary"
                        href="{{ path('admin_log_list', {
                            date: nextDate|date('Y-m-d')
                        }) }}"
                        aria-label="{{ 'logs.navigation.next'|trans }}"
                    >
                        →
                    </a>
                {% else %}
                    <span
                        class="button button--secondary is-disabled"
                        aria-hidden="true"
                    >
                        →
                    </span>
                {% endif %}

                {% if
                    selectedDate|date('Y-m-d')
                    != 'now'|date('Y-m-d')
                %}
                    <a
                        class="admin-logs__today"
                        href="{{ path('admin_log_list') }}"
                    >
                        {{ 'logs.navigation.today'|trans }}
                    </a>
                {% endif %}
            </div>
        </header>

        {% if not logFileExists %}
            <div class="admin-log-empty">
                {{ 'logs.empty.no_file'|trans }}
            </div>
        {% elseif logs is empty %}
            <div class="admin-log-empty">
                {{ 'logs.empty.no_errors'|trans }}
            </div>
        {% else %}
            <div class="admin-log-list">
                {% for log in logs %}
                    <article class="admin-log">
                        <header class="admin-log__header">
                            <span
                                class="
                                    admin-log__level
                                    admin-log__level--{{ log.level|lower }}
                                "
                            >
                                {{ log.level }}
                            </span>

                            <span class="admin-log__channel">
                                {{ log.channel }}
                            </span>

                            <time datetime="{{ log.date|date('c') }}">
                                {{ log.date|date('H:i:s') }}
                            </time>
                        </header>

                        <pre class="admin-log__message">{{ log.message }}</pre>
                    </article>
                {% endfor %}
            </div>
        {% endif %}
    </section>
{% endblock %}
