{% trans_default_domain 'calendar' %}

<section class="calendar-card">
    <div class="availability-table">
        <div class="availability-table__corner">
            {{ 'table.participant'|trans }}
        </div>

        {% for day in calendar.days %}
            {% set hasSelectedSession =
                day.afternoonSlot.isSelected
                or day.eveningSlot.isSelected
            %}

            <div
                class="
                    availability-table__day
                    {{ hasSelectedSession ? 'has-session' }}
                "
            >
                <strong>
                    {{ day.label }}
                </strong>

                <span>
                    {{ day.date|date('d/m') }}
                </span>
            </div>
        {% endfor %}

        <div class="availability-table__subheader"></div>

        {% include 'calendar/_desktop_periods.html.twig' %}

        {% for row in calendar.rows %}
            {% include 'calendar/_participant_row.html.twig' with {
                row: row
            } %}
        {% else %}
            <div class="availability-table__empty">
                {{ 'table.no_participant'|trans }}
            </div>
        {% endfor %}

        {% include 'components/calendar/_results.html.twig' %}

        {% include 'calendar/_decision_desktop.html.twig' %}
    </div>
</section>
