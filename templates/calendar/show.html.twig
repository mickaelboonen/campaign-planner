{% extends 'base.html.twig' %}

{% block title %}
    Calendrier — {{ campaign.name }}
{% endblock %}

{% block body %}
    {% include 'components/breadcrumb.html.twig' with {
        items: [
            {
                label: 'Campagnes',
                path: path('campaign_list')
            },
            {
                label: campaign.name,
                path: path('campaign_show', {
                    id: campaign.id
                })
            },
            {
                label: 'Calendrier'
            }
        ]
    } %}

    {% include 'components/page-header.html.twig' with {
        eyebrow: 'Disponibilités',
        title: 'Calendrier',
        description: 'Semaine du '
            ~ calendar.start|date('d/m/Y')
            ~ ' au '
            ~ calendar.end|date('d/m/Y')
    } %}

    <section class="calendar-toolbar">
        <a
            class="button button--secondary"
            href="{{ path('calendar_show', {
                id: campaign.id,
                week: calendar.previousWeek|date('Y-m-d')
            }) }}"
        >
            ← Semaine précédente
        </a>

        <a
            class="button button--secondary"
            href="{{ path('calendar_show', {
                id: campaign.id
            }) }}"
        >
            Cette semaine
        </a>

        <a
            class="button button--secondary"
            href="{{ path('calendar_show', {
                id: campaign.id,
                week: calendar.nextWeek|date('Y-m-d')
            }) }}"
        >
            Semaine suivante →
        </a>
    </section>

    <form
        {% if not isPastWeek %}
            method="post"
            action="{{ path('calendar_save_slots', {
                id: campaign.id
            }) }}"
            data-controller="calendar-slot-grid"
            data-action="submit->calendar-slot-grid#submit"
        {% endif %}
    >
        {% if not isPastWeek %}
            <input
                type="hidden"
                name="_token"
                value="{{ csrf_token(
                    'save-calendar-slots-' ~ campaign.id
                ) }}"
            >

            <input
                type="hidden"
                name="week"
                value="{{ calendar.start|date('Y-m-d') }}"
            >

            <section class="availability-editor">
                <div class="availability-editor__status">
                    <span class="availability-editor__label">
                        Action à appliquer
                    </span>

                    <button
                        type="button"
                        class="availability-status-button is-unavailable"
                        data-calendar-slot-grid-target="modeButton"
                        data-action="calendar-slot-grid#selectMode"
                        data-mode="blocked"
                    >
                        × Bloquer
                    </button>

                    <button
                        type="button"
                        class="availability-status-button is-available"
                        data-calendar-slot-grid-target="modeButton"
                        data-action="calendar-slot-grid#selectMode"
                        data-mode="open"
                    >
                        ✓ Ouvrir
                    </button>
                </div>

                <div class="availability-editor__shortcuts">
                    <span class="availability-editor__label">
                        Actions rapides
                    </span>

                    <button
                        type="button"
                        class="button button--secondary"
                        data-action="calendar-slot-grid#applyShortcut"
                        data-scope="all"
                    >
                        Toute la semaine
                    </button>

                    <button
                        type="button"
                        class="button button--secondary"
                        data-action="calendar-slot-grid#applyShortcut"
                        data-scope="afternoon"
                    >
                        Tous les après-midi
                    </button>

                    <button
                        type="button"
                        class="button button--secondary"
                        data-action="calendar-slot-grid#applyShortcut"
                        data-scope="evening"
                    >
                        Tous les soirs
                    </button>
                </div>
            </section>
        {% else %}
            <div class="calendar-readonly-notice">
                Cette semaine est passée et ne peut plus être modifiée.
            </div>
        {% endif %}

        <section class="calendar-legend">
            <span class="calendar-legend__item is-available">
                <span class="calendar-legend__symbol">✓</span>
                Disponible
            </span>

            <span class="calendar-legend__item is-maybe">
                <span class="calendar-legend__symbol">?</span>
                Peut-être
            </span>

            <span class="calendar-legend__item is-unavailable">
                <span class="calendar-legend__symbol">×</span>
                Indisponible
            </span>

            <span class="calendar-legend__item is-empty">
                <span class="calendar-legend__symbol">—</span>
                Non renseigné
            </span>

            <span class="calendar-legend__item is-blocked">
                <span class="calendar-legend__symbol">×</span>
                Créneau bloqué
            </span>
        </section>

        <section class="calendar-card">
            <div class="availability-table">
                <div class="availability-table__corner">
                    Participant
                </div>

                {% for day in calendar.days %}
                    <div class="availability-table__day">
                        <strong>{{ day.label }}</strong>
                        <span>{{ day.date|date('d/m') }}</span>
                    </div>
                {% endfor %}

                <div class="availability-table__subheader"></div>

                {% for day in calendar.days %}
                    {% set afternoonStatus =
                        day.afternoonSlot.blocked ? 'blocked' : 'open'
                    %}

                    {% set eveningStatus =
                        day.eveningSlot.blocked ? 'blocked' : 'open'
                    %}

                    <div class="availability-table__periods">
                        {% if not isPastWeek %}
                            <button
                                type="button"
                                class="
                                    availability-table__period-button
                                    {{ afternoonStatus == 'blocked'
                                        ? 'is-blocked'
                                        : 'is-open'
                                    }}
                                "
                                data-calendar-slot-grid-target="slot"
                                data-action="calendar-slot-grid#updateSlot"
                                data-slot-id="{{ day.afternoonSlot.id }}"
                                data-period="afternoon"
                                data-label="Après-midi"
                                data-status="{{ afternoonStatus }}"
                            >
                                <span class="availability-table__period-label">
                                    {{ afternoonStatus == 'blocked'
                                        ? 'Bloqué'
                                        : 'Après-midi'
                                    }}
                                </span>
                            </button>

                            <input
                                type="hidden"
                                name="slots[{{ day.afternoonSlot.id }}]"
                                value="{{ afternoonStatus }}"
                                data-calendar-slot-grid-target="input"
                                data-slot-id="{{ day.afternoonSlot.id }}"
                                data-initial-value="{{ afternoonStatus }}"
                            >
                        {% else %}
                            <div
                                class="
                                    availability-table__period-button
                                    {{ afternoonStatus == 'blocked'
                                        ? 'is-blocked'
                                        : 'is-open'
                                    }}
                                "
                            >
                                <span class="availability-table__period-label">
                                    {{ afternoonStatus == 'blocked'
                                        ? 'Bloqué'
                                        : 'Après-midi'
                                    }}
                                </span>
                            </div>
                        {% endif %}

                        {% if not isPastWeek %}
                            <button
                                type="button"
                                class="
                                    availability-table__period-button
                                    {{ eveningStatus == 'blocked'
                                        ? 'is-blocked'
                                        : 'is-open'
                                    }}
                                "
                                data-calendar-slot-grid-target="slot"
                                data-action="calendar-slot-grid#updateSlot"
                                data-slot-id="{{ day.eveningSlot.id }}"
                                data-period="evening"
                                data-label="Soir"
                                data-status="{{ eveningStatus }}"
                            >
                                <span class="availability-table__period-label">
                                    {{ eveningStatus == 'blocked'
                                        ? 'Bloqué'
                                        : 'Soir'
                                    }}
                                </span>
                            </button>

                            <input
                                type="hidden"
                                name="slots[{{ day.eveningSlot.id }}]"
                                value="{{ eveningStatus }}"
                                data-calendar-slot-grid-target="input"
                                data-slot-id="{{ day.eveningSlot.id }}"
                                data-initial-value="{{ eveningStatus }}"
                            >
                        {% else %}
                            <div
                                class="
                                    availability-table__period-button
                                    {{ eveningStatus == 'blocked'
                                        ? 'is-blocked'
                                        : 'is-open'
                                    }}
                                "
                            >
                                <span class="availability-table__period-label">
                                    {{ eveningStatus == 'blocked'
                                        ? 'Bloqué'
                                        : 'Soir'
                                    }}
                                </span>
                            </div>
                        {% endif %}
                    </div>
                {% endfor %}

                {% for row in calendar.rows %}
                    <div class="availability-table__participant">
                        <strong>{{ row.participant.name }}</strong>

                        {% if row.participant.characterName %}
                            <span>{{ row.participant.characterName }}</span>
                        {% endif %}
                    </div>

                    {% for dayIndex in 0..6 %}
                        {% set afternoonCell = row.cells[dayIndex * 2] %}
                        {% set eveningCell = row.cells[(dayIndex * 2) + 1] %}

                        <div class="availability-table__cells">
                            <div
                                class="
                                    availability-cell
                                    {{ afternoonCell.cssClass }}
                                "
                                title="{{ afternoonCell.label }}"
                                data-calendar-slot-id="{{ afternoonCell.slot.id }}"
                            >
                                <span class="availability-cell__symbol">
                                    {{ afternoonCell.symbol }}
                                </span>
                            </div>

                            <div
                                class="
                                    availability-cell
                                    {{ eveningCell.cssClass }}
                                "
                                title="{{ eveningCell.label }}"
                                data-calendar-slot-id="{{ eveningCell.slot.id }}"
                            >
                                <span class="availability-cell__symbol">
                                    {{ eveningCell.symbol }}
                                </span>
                            </div>
                        </div>
                    {% endfor %}
                {% else %}
                    <div class="availability-table__empty">
                        Aucun participant actif dans cette campagne.
                    </div>
                {% endfor %}

                {% if calendar.rows is not empty %}
                    <div class="availability-table__results-label">
                        Résultats
                    </div>

                    {% for day in calendar.days %}
                        <div class="availability-table__results">
                            <div class="availability-table__result-slot">
                                {% if day.afternoonSlot.blocked %}
                                    <span class="availability-table__result-blocked">
                                        Créneau bloqué
                                    </span>
                                {% else %}
                                    <span class="availability-table__summary-item is-available">
                                        <span>{{ day.afternoonSummary.availableCount }}</span>
                                        <span class="availability-table__summary-symbol">✓</span>
                                    </span>

                                    <span class="availability-table__summary-item is-maybe">
                                        <span>{{ day.afternoonSummary.maybeCount }}</span>
                                        <span class="availability-table__summary-symbol">?</span>
                                    </span>

                                    <span class="availability-table__summary-item is-unavailable">
                                        <span>{{ day.afternoonSummary.unavailableCount }}</span>
                                        <span class="availability-table__summary-symbol">×</span>
                                    </span>

                                    <span class="availability-table__summary-item is-unanswered">
                                        <span>{{ day.afternoonSummary.unansweredCount }}</span>
                                        <span class="availability-table__summary-symbol">—</span>
                                    </span>
                                {% endif %}
                            </div>

                            <div class="availability-table__result-slot">
                                {% if day.eveningSlot.blocked %}
                                    <span class="availability-table__result-blocked">
                                        Créneau bloqué
                                    </span>
                                {% else %}
                                    <span class="availability-table__summary-item is-available">
                                        <span>{{ day.afternoonSummary.availableCount }}</span>
                                        <span class="availability-table__summary-symbol">✓</span>
                                    </span>

                                    <span class="availability-table__summary-item is-maybe">
                                        <span>{{ day.afternoonSummary.maybeCount }}</span>
                                        <span class="availability-table__summary-symbol">?</span>
                                    </span>

                                    <span class="availability-table__summary-item is-unavailable">
                                        <span>{{ day.afternoonSummary.unavailableCount }}</span>
                                        <span class="availability-table__summary-symbol">×</span>
                                    </span>

                                    <span class="availability-table__summary-item is-unanswered">
                                        <span>{{ day.afternoonSummary.unansweredCount }}</span>
                                        <span class="availability-table__summary-symbol">—</span>
                                    </span>
                                {% endif %}
                            </div>
                        </div>
                    {% endfor %}
                {% endif %}
            </div>
        </section>

        {% if not isPastWeek %}
            <div class="availability-save">
                <p class="availability-save__hint">
                    Les modifications ne sont enregistrées qu’après validation.
                </p>

                <button
                    type="submit"
                    class="button button--primary"
                    data-calendar-slot-grid-target="saveButton"
                    disabled
                >
                    Enregistrer les créneaux
                </button>
            </div>
        {% endif %}
    </form>
{% endblock %}