{% extends 'base.html.twig' %}

{% trans_default_domain 'calendar' %}

{% block title %}
    {{ 'title'|trans }} — {{ campaign.name }}
{% endblock %}

{% block body %}
    {% include 'components/breadcrumb.html.twig' with {
        items: [
            {
                label: 'breadcrumb.campaigns'|trans,
                path: path('campaign_list')
            },
            {
                label: campaign.name,
                path: path('campaign_show', {
                    id: campaign.id
                })
            },
            {
                label: 'breadcrumb.calendar'|trans
            }
        ]
    } %}

    {% include 'components/page-header.html.twig' with {
        eyebrow: 'header.eyebrow'|trans,
        title: 'title'|trans,
        description: 'header.description'|trans({
            '%week%': calendar.start|date('W'),
            '%start%': calendar.start|date('d/m/Y'),
            '%end%': calendar.end|date('d/m/Y')
        })
    } %}

    {% if campaign.isArchived %}
        <div class="campaign-readonly-notice">
            {{ 'readonly.archived'|trans }}
        </div>
    {% endif %}

    {% include 'calendar/_toolbar.html.twig' %}

    <form
        {% if not isPastWeek %}
            method="post"
            action="{{ path('calendar_save_slots', {
                id: campaign.id
            }) }}"
            data-controller="calendar-slot-grid"
            data-action="submit->calendar-slot-grid#submit"
            data-calendar-slot-grid-blocked-label-value="{{ 'availability_status.blocked'|trans({}, 'enums') }}"
            data-calendar-slot-grid-unsaved-changes-message-value="{{ 'unsaved_changes'|trans }}"
        {% endif %}
    >
        {% if not isPastWeek %}
            <input
                type="hidden"
                name="_token"
                value="{{ csrf_token(
                    'save-calendar-slots-' ~ campaign.id
                ) }}"
            >

            <input
                type="hidden"
                name="week"
                value="{{ calendar.start|date('Y-m-d') }}"
            >
        {% endif %}

        {% include 'calendar/_editor.html.twig' %}

        <div class="calendar-desktop">
            {% include 'calendar/_desktop.html.twig' %}
        </div>

        <div class="calendar-mobile">
            {% include 'calendar/_mobile.html.twig' %}
        </div>

        {% include 'calendar/_save.html.twig' %}
    </form>
{% endblock %}
