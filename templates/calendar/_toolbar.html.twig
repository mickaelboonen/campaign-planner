{% trans_default_domain 'calendar' %}

<section class="calendar-toolbar">
    <div class="calendar-toolbar__navigation">
        <a
            class="button button--secondary calendar-toolbar__button"
            href="{{ path('calendar_show', {
                id: campaign.id,
                week: calendar.previousWeek|date('Y-m-d')
            }) }}"
            aria-label="{{ 'toolbar.previous_week'|trans }}"
        >
            <span class="calendar-toolbar__desktop-label">
                ← {{ 'toolbar.previous_week'|trans }}
            </span>

            <span class="calendar-toolbar__mobile-label">
                ←
            </span>
        </a>

        <a
            class="button button--secondary calendar-toolbar__button"
            href="{{ path('calendar_show', {
                id: campaign.id
            }) }}"
        >
            {{ 'toolbar.current_week'|trans }}
        </a>

        <a
            class="button button--secondary calendar-toolbar__button"
            href="{{ path('calendar_show', {
                id: campaign.id,
                week: calendar.nextWeek|date('Y-m-d')
            }) }}"
            aria-label="{{ 'toolbar.next_week'|trans }}"
        >
            <span class="calendar-toolbar__desktop-label">
                {{ 'toolbar.next_week'|trans }} →
            </span>

            <span class="calendar-toolbar__mobile-label">
                →
            </span>
        </a>
    </div>

    <form
        method="get"
        action="{{ path('calendar_show', {
            id: campaign.id
        }) }}"
        class="calendar-week-picker"
    >
        <label
            for="calendar-week-picker"
            class="sr-only"
        >
            {{ 'toolbar.choose_week'|trans }}
        </label>

        <select
            id="calendar-week-picker"
            name="week"
            onchange="this.form.submit()"
        >
            {% for week in availableWeeks %}
                <option
                    value="{{ week.start|date('Y-m-d') }}"
                    {% if
                        week.start|date('Y-m-d')
                        == calendar.start|date('Y-m-d')
                    %}
                        selected
                    {% endif %}
                >
                    {{ week.start|date('d/m') }}
                    —
                    {{ week.end|date('d/m/Y') }}
                </option>
            {% endfor %}
        </select>
    </form>
</section>
