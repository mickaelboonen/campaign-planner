{% trans_default_domain 'calendar' %}

{% if not isPastWeek %}
    <section class="availability-editor">
        <div class="availability-editor__status">
            <span class="availability-editor__label">
                {{ 'editor.action'|trans }}
            </span>

            <button
                type="button"
                class="availability-status-button is-unavailable"
                data-calendar-slot-grid-target="modeButton"
                data-action="calendar-slot-grid#selectMode"
                data-mode="blocked"
            >
                × {{ 'editor.block'|trans }}
            </button>

            <button
                type="button"
                class="availability-status-button is-available"
                data-calendar-slot-grid-target="modeButton"
                data-action="calendar-slot-grid#selectMode"
                data-mode="open"
            >
                ✓ {{ 'editor.open'|trans }}
            </button>
        </div>

        <div class="availability-editor__shortcuts">
            <span class="availability-editor__label">
                {{ 'editor.shortcuts.label'|trans }}
            </span>

            <button
                type="button"
                class="button button--secondary"
                data-action="calendar-slot-grid#applyShortcut"
                data-scope="all"
            >
                {{ 'editor.shortcuts.all_week'|trans }}
            </button>

            <button
                type="button"
                class="button button--secondary"
                data-action="calendar-slot-grid#applyShortcut"
                data-scope="afternoon"
            >
                {{ 'editor.shortcuts.all_afternoons'|trans }}
            </button>

            <button
                type="button"
                class="button button--secondary"
                data-action="calendar-slot-grid#applyShortcut"
                data-scope="evening"
            >
                {{ 'editor.shortcuts.all_evenings'|trans }}
            </button>
        </div>
    </section>
{% else %}
    <div class="calendar-readonly-notice">
        {{ 'readonly.past_week'|trans }}
    </div>
{% endif %}
