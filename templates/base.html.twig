{% extends 'root.html.twig' %}

{% block layout %}
    <body>
        <div class="app-layout" data-controller="mobile-navigation" >

            {% include 'components/notifications.html.twig' %}

            <header class="mobile-header">
                <button class="mobile-header__toggle" type="button" aria-label="Ouvrir la navigation" data-action="mobile-navigation#toggle" > ☰ </button>
                <a class="mobile-header__brand" href="{{ path('dashboard') }}">CampaignPlanner</a>
            </header>

            <div class="mobile-overlay" data-mobile-navigation-target="overlay" data-action="click->mobile-navigation#close" ></div>

            {% include 'components/sidebar.html.twig' %}

            <main class="main-content">
                {% for message in app.flashes('success') %}
                    <div class="flash flash--success">
                        {{ message }}
                    </div>
                {% endfor %}

                {% block body %}{% endblock %}
            </main>

            {% include 'components/footer.html.twig' %}
        </div>
    </body>
{% endblock %}
