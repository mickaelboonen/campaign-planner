<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">

        <meta
            name="viewport"
            content="width=device-width, initial-scale=1"
        >

        <title>
            {% block title %}CampaignPlanner{% endblock %}
            — CampaignPlanner
        </title>

        {% block stylesheets %}
            {{ importmap('app') }}
        {% endblock %}
    </head>

    <body>
        <div class="app-layout">
            <aside class="sidebar">
                <a class="brand" href="{{ path('dashboard') }}">
                    <span class="brand__emblem">◆</span>

                    <span>
                        <strong>Campaign</strong><em>Planner</em>
                    </span>
                </a>

                <nav class="sidebar-nav" aria-label="Navigation principale">
                    <a
                        class="sidebar-nav__link {{ app.current_route == 'dashboard' ? 'is-active' }}"
                        href="{{ path('dashboard') }}"
                    >
                        <span>⌂</span>
                        Tableau de bord
                    </a>

                    <a
                        class="sidebar-nav__link {{ app.current_route starts with 'campaign_' ? 'is-active' }}"
                        href="{{ path('campaign_list') }}"
                    >
                        <span>◆</span>
                        Campagnes
                    </a>

                    <span class="sidebar-nav__link is-disabled">
                        <span>▦</span>
                        Calendrier
                    </span>
                </nav>

                <div class="sidebar__footer">
                    {% if app.user %}
                        <span class="sidebar__user">
                            {{ app.user.userIdentifier }}
                        </span>

                        <a class="sidebar__logout" href="{{ path('app_logout') }}">
                            Déconnexion
                        </a>
                    {% endif %}
                </div>
            </aside>

            <main class="main-content">
                {% for message in app.flashes('success') %}
                    <div class="flash flash--success">
                        {{ message }}
                    </div>
                {% endfor %}

                {% block body %}{% endblock %}
            </main>
        </div>
    </body>
</html>