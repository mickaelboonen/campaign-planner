<article class="participant-card">
    <header class="participant-card__header">
        <div class="participant-card__avatar">
            {{ participant.name|slice(0, 1)|upper }}
        </div>

        <div>
            <h3 class="participant-card__name">
                {{ participant.name }}
            </h3>

            {% if participant.characterName %}
                <p class="participant-card__character">
                    {{ participant.characterName }}
                </p>
            {% endif %}
        </div>
    </header>

    <div class="participant-card__content">
        <a
            class="participant-card__email"
            href="mailto:{{ participant.email }}"
        >
            {{ participant.email }}
        </a>

        {% if participant.phone %}
            <span class="participant-card__phone">
                {{ participant.phone }}
            </span>
        {% endif %}
    </div>

    <footer class="participant-card__footer">
        <div class="participant-card__actions">

            {% if not readOnly %}
                <a
                    href="{{ path('participant_edit', {
                        id: participant.campaign.id,
                        participant: participant.id
                    }) }}"
                    class="button button--secondary"
                >
                    Modifier
                </a>

                <button
                    type="button"
                    class="button button--secondary"
                    data-controller="clipboard"
                    data-action="clipboard#copy"
                    data-clipboard-value-value="{{ url('participant_availability_show', {
                        token: participant.accessToken
                    }) }}"
                >
                    Copier calendrier
                </button>

                <form
                    method="post"
                    action="{{ path('participant_archive', {
                        id: participant.campaign.id,
                        participant: participant.id
                    }) }}"
                    onsubmit="return confirm('Archiver ce participant ?');"
                >
                    <input
                        type="hidden"
                        name="_token"
                        value="{{ csrf_token(
                            'archive-participant-' ~ participant.id
                        ) }}"
                    >

                    <button
                        type="submit"
                        class="button button--ghost"
                    >
                        Archiver
                    </button>
                </form>
            {% endif %}
        </div>
    </footer>
</article>
