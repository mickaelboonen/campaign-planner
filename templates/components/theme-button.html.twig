{% trans_default_domain 'common' %}

<div
    class="theme-switch"
    data-controller="theme"
    data-theme-light-label-value="{{ 'theme.light'|trans }}"
    data-theme-dark-label-value="{{ 'theme.dark'|trans }}"
>
    <span
        class="theme-switch__icon"
        data-theme-target="icon"
        aria-hidden="true"
    >
        ☀
    </span>

    <span
        class="theme-switch__label"
        data-theme-target="label"
    >
        {{ 'theme.light'|trans }}
    </span>

    <button
        type="button"
        class="theme-switch__button"
        role="switch"
        aria-checked="false"
        aria-label="{{ 'theme.toggle'|trans }}"
        data-theme-target="button"
        data-action="theme#toggle"
    >
        <span class="theme-switch__thumb"></span>
    </button>
</div>
