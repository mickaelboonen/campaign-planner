{% extends 'emails/_layout.html.twig' %}

{% trans_default_domain 'emails' %}

{% block title %}
    {{ 'session_reminder.title'|trans }}
{% endblock %}

{% block content %}
    <p class="email-text">
        {{ 'session_reminder.greeting'|trans({
            '%name%': participant.name
        }) }}
    </p>

    <p class="email-text">
        {{ 'session_reminder.intro'|trans({
            '%campaign%': campaign.name
        }) }}
    </p>

    {% include 'emails/_session_details.html.twig' %}

    <p class="email-text">
        {{ 'session_reminder.prepare'|trans }}
    </p>

    {% include 'emails/_dashboard_button.html.twig' %}
{% endblock %}
