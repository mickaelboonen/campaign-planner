{% extends 'emails/_layout.html.twig' %}

{% trans_default_domain 'emails' %}

{% block title %}
    {{ 'participant_access.title'|trans({
        '%campaign%': campaign.name
    }) }}
{% endblock %}

{% block heading %}
    {{ 'participant_access.heading'|trans }}
{% endblock %}

{% block content %}
    <p class="email-text">
        {{ 'participant_access.greeting'|trans({
            '%name%': participant.name
        }) }}
    </p>

    <p class="email-text">
        {{ 'participant_access.added'|trans({
            '%campaign%': campaign.name
        }) }}
    </p>

    <div class="email-panel email-panel--accent">
        <div class="email-panel__label">
            {{ 'participant_access.player_space'|trans }}
        </div>

        <p class="email-text">
            {{ 'participant_access.description'|trans }}
        </p>
    </div>

    {% include 'emails/_dashboard_button.html.twig' with {
        dashboardUrl: dashboardUrl
    } %}

    <p
        class="
            email-text
            email-text--small
            email-text--center
        "
    >
        {{ 'participant_access.warning'|trans }}
    </p>
{% endblock %}
