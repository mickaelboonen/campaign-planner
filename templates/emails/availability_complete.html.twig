{% extends 'emails/_layout.html.twig' %}

{% trans_default_domain 'emails' %}

{% block title %}
    {{ 'availability_complete.title'|trans({
        '%campaign%': campaign.name
    }) }}
{% endblock %}

{% block heading %}
    {{ 'availability_complete.heading'|trans }}
{% endblock %}

{% block content %}
    <p class="email-text">
        {{ 'availability_complete.message'|trans({
            '%campaign%': campaign.name,
            '%start%': weekStart|date('d/m/Y'),
            '%end%': weekEnd|date('d/m/Y')
        }) }}
    </p>

    <p class="email-text email-text--muted email-text--large-gap">
        {{ 'availability_complete.description'|trans }}
    </p>

    <table
        role="presentation"
        cellspacing="0"
        cellpadding="0"
        border="0"
        align="center"
    >
        <tr>
            <td
                class="email-action-wrapper"
                align="center"
            >
                <a
                    href="{{ calendarUrl }}"
                    class="email-action"
                >
                    {{ 'availability_complete.action'|trans }}
                </a>
            </td>
        </tr>
    </table>
{% endblock %}
