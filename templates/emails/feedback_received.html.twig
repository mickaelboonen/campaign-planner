{% extends 'emails/_layout.html.twig' %}

{% trans_default_domain 'emails' %}

{% block title %}
    {{ 'feedback_received.title'|trans }}
{% endblock %}

{% block heading %}
    {{ 'feedback_received.heading'|trans }}
{% endblock %}

{% block content %}
    <p class="email-text">
        {{ 'feedback_received.intro'|trans }}
    </p>

    <div class="email-panel email-panel--accent">
        <div class="email-panel__label">
            {{
                feedback.type
                    .translationKey()
                    |trans({}, 'enums')
            }}
        </div>

        <p class="email-panel__line">
            <strong>
                {{ 'feedback_received.from'|trans }}
            </strong>

            {{
                feedback.email
                ?? 'feedback_received.unknown_address'|trans
            }}
        </p>

        {% if feedback.user %}
            <p class="email-text email-text--muted">
                {{ 'feedback_received.connected_user'|trans }}
                {{ feedback.user.userIdentifier }}
            </p>
        {% endif %}
    </div>

    <div class="email-message">
        <div class="email-message__subject">
            {{ feedback.subject }}
        </div>

        <div class="email-message__label">
            {{ 'feedback_received.message'|trans }}
        </div>

        <p class="email-message__content">
            {{ feedback.message }}
        </p>
    </div>
{% endblock %}

{% block footer %}
    {{ 'feedback_received.footer'|trans }}
{% endblock %}
