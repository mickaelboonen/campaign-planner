<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">

    <title>
        Nouvelle session - {{ campaign.name }}
    </title>
</head>

<body
    style="
        margin: 0;
        padding: 32px 0;
        background: #111318;
        color: #f3f3f3;
        font-family: Arial, Helvetica, sans-serif;
    "
>
    <table
        role="presentation"
        cellspacing="0"
        cellpadding="0"
        border="0"
        width="100%"
    >
        <tr>
            <td align="center">
                <table
                    role="presentation"
                    cellspacing="0"
                    cellpadding="0"
                    border="0"
                    width="600"
                    style="
                        overflow: hidden;
                        border: 1px solid #2c3038;
                        border-radius: 14px;
                        background: #191b21;
                    "
                >
                    <tr>
                        <td
                            style="
                                padding: 32px;
                                text-align: center;
                                background: #20242c;
                            "
                        >
                            <div
                                style="
                                    margin-bottom: 12px;
                                    color: #c9a85c;
                                    font-size: 13px;
                                    font-weight: 700;
                                    letter-spacing: 2px;
                                    text-transform: uppercase;
                                "
                            >
                                Campaign Planner
                            </div>

                            <h1
                                style="
                                    margin: 0;
                                    color: #ffffff;
                                    font-size: 30px;
                                    font-weight: 700;
                                "
                            >
                                🎲 Nouvelle session
                            </h1>
                        </td>
                    </tr>

                    <tr>
                        <td style="padding: 32px;">
                            <p
                                style="
                                    margin: 0 0 20px;
                                    color: #d4d7dd;
                                    font-size: 16px;
                                    line-height: 1.7;
                                "
                            >
                                Bonjour
                                <strong>{{ participant.name }}</strong>,
                            </p>

                            <p
                                style="
                                    margin: 0 0 24px;
                                    color: #d4d7dd;
                                    font-size: 16px;
                                    line-height: 1.7;
                                "
                            >
                                Une nouvelle session vient d'être validée pour votre campagne :
                            </p>

                            <div
                                style="
                                    margin-bottom: 28px;
                                    padding: 22px;
                                    border-left: 4px solid #c9a85c;
                                    border-radius: 8px;
                                    background: #242832;
                                "
                            >
                                <div
                                    style="
                                        margin-bottom: 14px;
                                        color: #c9a85c;
                                        font-size: 13px;
                                        font-weight: 700;
                                        letter-spacing: 1px;
                                        text-transform: uppercase;
                                    "
                                >
                                    Campagne
                                </div>

                                <div
                                    style="
                                        margin-bottom: 20px;
                                        color: #ffffff;
                                        font-size: 24px;
                                        font-weight: 700;
                                    "
                                >
                                    {{ campaign.name }}
                                </div>

                                <table
                                    role="presentation"
                                    cellspacing="0"
                                    cellpadding="0"
                                    border="0"
                                >
                                    <tr>
                                        <td
                                            style="
                                                padding-right: 24px;
                                                color: #9da3af;
                                                font-size: 14px;
                                            "
                                        >
                                            📅 Date
                                        </td>

                                        <td
                                            style="
                                                color: #ffffff;
                                                font-size: 16px;
                                                font-weight: 600;
                                            "
                                        >
                                            {{ session.date|format_date(
                                                pattern: 'EEEE d MMMM yyyy',
                                                locale: 'fr'
                                            ) }}
                                        </td>
                                    </tr>

                                    <tr>
                                        <td
                                            style="
                                                padding-top: 12px;
                                                padding-right: 24px;
                                                color: #9da3af;
                                                font-size: 14px;
                                            "
                                        >
                                            🕒 Créneau
                                        </td>

                                        <td
                                            style="
                                                padding-top: 12px;
                                                color: #ffffff;
                                                font-size: 16px;
                                                font-weight: 600;
                                            "
                                        >
                                            {{ session.period.label() }}
                                        </td>
                                    </tr>
                                </table>
                            </div>

                            <p
                                style="
                                    margin: 0 0 30px;
                                    color: #d4d7dd;
                                    font-size: 15px;
                                    line-height: 1.7;
                                "
                            >
                                Pensez à vérifier vos disponibilités si nécessaire et préparez vos dés !
                            </p>

                            <table
                                role="presentation"
                                cellspacing="0"
                                cellpadding="0"
                                border="0"
                                align="center"
                            >
                                <tr>
                                    <td
                                        style="
                                            border-radius: 8px;
                                            background: #c9a85c;
                                        "
                                    >
                                        <a
                                            href="{{ url('campaign_show', {
                                                id: campaign.id
                                            }) }}"
                                            style="
                                                display: inline-block;
                                                padding: 14px 28px;
                                                color: #111318;
                                                font-size: 15px;
                                                font-weight: 700;
                                                text-decoration: none;
                                            "
                                        >
                                            Voir la campagne
                                        </a>
                                    </td>
                                </tr>
                            </table>
                        </td>
                    </tr>

                    <tr>
                        <td
                            style="
                                padding: 24px;
                                border-top: 1px solid #2c3038;
                                text-align: center;
                                color: #7d828d;
                                font-size: 12px;
                                line-height: 1.6;
                            "
                        >
                            Cet email a été envoyé automatiquement par
                            <strong style="color:#c9a85c;">
                                Campaign Planner
                            </strong>.
                            <br>
                            Bon jeu !
                        </td>
                    </tr>
                </table>
            </td>
        </tr>
    </table>
</body>
</html>
