{% extends 'emails/_layout.html.twig' %}

{% trans_default_domain 'emails' %}

{% block title %}
    {{ 'session_scheduled.title'|trans({
        '%campaign%': campaign.name
    }) }}
{% endblock %}

{% block heading %}
    {{ 'session_scheduled.heading'|trans }}
{% endblock %}

{% block content %}
    <p class="email-text">
        {{ 'session_scheduled.greeting'|trans({
            '%name%': participant.name
        }) }}
    </p>

    <p class="email-text">
        {{ 'session_scheduled.intro'|trans }}
    </p>

    {% include 'emails/_session_details.html.twig' %}

    <p class="email-text email-text--large-gap">
        {{ 'session_scheduled.prepare'|trans }}
    </p>

    {% include 'emails/_dashboard_button.html.twig' %}
{% endblock %}
