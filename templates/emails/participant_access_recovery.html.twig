{% extends 'emails/_layout.html.twig' %}

{% trans_default_domain 'emails' %}

{% block title %}
    {{ 'participant_access_recovery.title'|trans }}
{% endblock %}

{% block heading %}
    {{ 'participant_access_recovery.heading'|trans }}
{% endblock %}

{% block content %}
    <p class="email-text">
        {{ 'participant_access_recovery.greeting'|trans({
            '%name%': participant.name
        }) }}
    </p>

    <p class="email-text">
        {{ 'participant_access_recovery.request'|trans }}
    </p>

    <p class="email-text email-text--muted email-text--large-gap">
        {{ 'participant_access_recovery.description'|trans }}
    </p>

    {% include 'emails/_dashboard_button.html.twig' with {
        dashboardUrl: dashboardUrl
    } %}

    <p class="email-text email-text--separator">
        {{ 'participant_access_recovery.ignored'|trans }}
    </p>
{% endblock %}
