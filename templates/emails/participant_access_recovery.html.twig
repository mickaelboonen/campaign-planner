{% extends 'emails/_layout.html.twig' %}

{% block title %}
    Votre accès Campaign Planner
{% endblock %}

{% block heading %}
    🔑 Votre espace joueur
{% endblock %}

{% block content %}
    <p
        style="
            margin: 0 0 20px;
            color: #d4d7dd;
            font-size: 16px;
            line-height: 1.7;
        "
    >
        Bonjour <strong>{{ participant.name }}</strong>,
    </p>

    <p
        style="
            margin: 0 0 24px;
            color: #d4d7dd;
            font-size: 16px;
            line-height: 1.7;
        "
    >
        Une demande a été effectuée pour retrouver
        le lien d'accès à votre espace joueur Campaign Planner.
    </p>

    <p
        style="
            margin: 0 0 28px;
            color: #a7a8ad;
            font-size: 15px;
            line-height: 1.7;
        "
    >
        Vous pouvez y retrouver toutes vos campagnes,
        vos prochaines sessions et vos disponibilités.
    </p>

    {% include 'emails/_dashboard_button.html.twig' with {
        dashboardUrl: dashboardUrl
    } %}

    <p
        style="
            margin: 28px 0 0;
            padding-top: 20px;
            border-top: 1px solid #2c3038;
            color: #7d828d;
            font-size: 13px;
            line-height: 1.6;
        "
    >
        Si vous n'êtes pas à l'origine de cette demande,
        aucune action n'est nécessaire. Vous pouvez simplement
        ignorer cet email.
    </p>
{% endblock %}
