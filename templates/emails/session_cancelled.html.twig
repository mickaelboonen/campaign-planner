{% extends 'emails/_layout.html.twig' %}

{% trans_default_domain 'emails' %}

{% block title %}
    {{ 'session_cancelled.title'|trans({
        '%campaign%': campaign.name
    }) }}
{% endblock %}

{% block heading %}
    {{ 'session_cancelled.heading'|trans }}
{% endblock %}

{% block content %}
    <p class="email-text">
        {{ 'session_cancelled.greeting'|trans({
            '%name%': participant.name
        }) }}
    </p>

    <p class="email-text">
        {{ 'session_cancelled.intro'|trans }}
    </p>

    {% include 'emails/_session_details.html.twig' with {
        danger: true
    } %}

    {% include 'emails/_dashboard_button.html.twig' %}
{% endblock %}
