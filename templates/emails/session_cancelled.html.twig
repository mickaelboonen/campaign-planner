{% extends 'emails/_layout.html.twig' %}

{% block title %}
    Session annulée - {{ campaign.name }}
{% endblock %}

{% block heading %}
    Session annulée
{% endblock %}

{% block content %}
    <p style="margin: 0 0 20px; color: #d4d7dd; font-size: 16px; line-height: 1.7;">
        Bonjour <strong>{{ participant.name }}</strong>,
    </p>

    <p style="margin: 0 0 24px; color: #d4d7dd; font-size: 16px; line-height: 1.7;">
        La session suivante vient d’être annulée :
    </p>

    {% include 'emails/_session_details.html.twig' with {
        accentColor: '#d77474'
    } %}

    {% include 'emails/_dashboard_button.html.twig' %}
{% endblock %}
