{% trans_default_domain 'emails' %}

<div
    class="
        email-panel
        {{ danger|default(false)
            ? 'email-panel--danger'
            : 'email-panel--accent'
        }}
    "
>
    <div class="email-panel__label">
        {{ 'session_details.campaign'|trans }}
    </div>

    <div class="email-panel__title">
        {{ campaign.name }}
    </div>

    {% if session.name %}
        <p class="email-panel__subtitle">
            🎲 {{ session.name }}
        </p>
    {% endif %}

    <p class="email-panel__line">
        📅
        {{ session.date|format_date(
            pattern: 'EEEE d MMMM yyyy'
        ) }}
    </p>

    <p class="email-panel__line">
        🕒
        {{
            session.period
                .translationKey()
                |trans({}, 'enums')
        }}
    </p>

    {% if session.startTime and session.endTime %}
        <p class="email-panel__line">
            ⏰
            {{ session.startTime|date('H:i', false) }}
            —
            {{ session.endTime|date('H:i', false) }}
        </p>
    {% endif %}
</div>
