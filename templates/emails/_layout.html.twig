<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">

    <title>
        {% block title %}
            Campaign Planner
        {% endblock %}
    </title>
</head>

<body
    style="
        margin: 0;
        padding: 32px 0;
        background: #111318;
        color: #f3f3f3;
        font-family: Arial, Helvetica, sans-serif;
    "
>
    <table
        role="presentation"
        cellspacing="0"
        cellpadding="0"
        border="0"
        width="100%"
    >
        <tr>
            <td align="center">
                <table
                    role="presentation"
                    cellspacing="0"
                    cellpadding="0"
                    border="0"
                    width="600"
                    style="
                        overflow: hidden;
                        border: 1px solid #2c3038;
                        border-radius: 14px;
                        background: #191b21;
                    "
                >
                    <tr>
                        <td
                            style="
                                padding: 32px;
                                text-align: center;
                                background: #20242c;
                            "
                        >
                            <div
                                style="
                                    margin-bottom: 12px;
                                    color: #c9a85c;
                                    font-size: 13px;
                                    font-weight: 700;
                                    letter-spacing: 2px;
                                    text-transform: uppercase;
                                "
                            >
                                Campaign Planner
                            </div>

                            <h1
                                style="
                                    margin: 0;
                                    color: #ffffff;
                                    font-size: 30px;
                                    font-weight: 700;
                                "
                            >
                                {% block heading %}{% endblock %}
                            </h1>
                        </td>
                    </tr>

                    <tr>
                        <td style="padding: 32px;">
                            {% block content %}{% endblock %}
                        </td>
                    </tr>

                    <tr>
                        <td
                            style="
                                padding: 24px;
                                border-top: 1px solid #2c3038;
                                text-align: center;
                                color: #7d828d;
                                font-size: 12px;
                                line-height: 1.6;
                            "
                        >
                            Cet email a été envoyé automatiquement par
                            <strong style="color:#c9a85c;">
                                Campaign Planner
                            </strong>.
                            <br>

                            {% block footer %}
                                À bientôt autour de la table !
                            {% endblock %}
                        </td>
                    </tr>
                </table>
            </td>
        </tr>
    </table>
</body>
</html>
