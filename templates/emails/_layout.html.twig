{% trans_default_domain 'emails' %}

<!DOCTYPE html>
<html lang="{{ app.request.locale }}">
<head>
    <meta charset="UTF-8">

    <title>
        {% block title %}
            Campaign Planner
        {% endblock %}
    </title>

    {% include 'emails/_styles.html.twig' %}
</head>

<body class="email-body">
    <table
        class="email-wrapper"
        role="presentation"
        cellspacing="0"
        cellpadding="0"
        border="0"
        width="100%"
    >
        <tr>
            <td align="center">
                <table
                    class="email-container"
                    role="presentation"
                    cellspacing="0"
                    cellpadding="0"
                    border="0"
                    width="600"
                >
                    <tr>
                        <td class="email-header">
                            <div class="email-brand">
                                Campaign Planner
                            </div>

                            <h1 class="email-heading">
                                {% block heading %}{% endblock %}
                            </h1>
                        </td>
                    </tr>

                    <tr>
                        <td class="email-content">
                            {% block content %}{% endblock %}
                        </td>
                    </tr>

                    <tr>
                        <td class="email-footer">
                            {{ 'layout.automatic'|trans }}

                            <strong class="email-footer__brand">
                                Campaign Planner
                            </strong>.

                            <br>

                            {% block footer %}
                                {{ 'layout.footer'|trans }}
                            {% endblock %}
                        </td>
                    </tr>
                </table>
            </td>
        </tr>
    </table>
</body>
</html>
